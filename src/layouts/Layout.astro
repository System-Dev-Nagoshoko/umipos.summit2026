---
interface Props {
	title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500;700;900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-container">
				<a href={baseUrl} class="logo-link">
					<img 
						src={`${baseUrl}logo.png`} 
						alt="Logo" 
						class="logo-img" 
					/>
					<span class="logo-text">Nago Youth Future Summit</span>
				</a>

				<nav class="nav">
					<a href={baseUrl}>TOP</a>
					<a href={`${baseUrl}about/`}>ABOUT</a>
					<a href={`${baseUrl}sns/`}>SNS</a>
					<a href={`${baseUrl}contact/`}>CONTACT</a>
				</nav>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="container">
				<p>&copy; 2026 Nago Youth Future Summit & うみポス</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--primary: #0284c7;
		--text: #0f172a;
		--bg: #f8fafc;
	}
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	body {
		font-family: 'Noto Sans JP', sans-serif;
		color: var(--text);
		background: var(--bg);
		line-height: 1.6;
		overflow-x: hidden; /* 横スクロールの発生を防止 */
	}
	h1, h2, h3 {
		font-weight: 900;
		letter-spacing: -0.02em;
	}
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 1.25rem;
	}

	/* ヘッダーのレスポンシブ対応 */
	.site-header {
		background: #ffffff;
		border-bottom: 1px solid #e2e8f0;
		position: sticky;
		top: 0;
		z-index: 50;
	}
	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		min-height: 70px;
		padding-top: 0.75rem;
		padding-bottom: 0.75rem;
		flex-wrap: wrap; /* スマホ時に折り返せるように */
		gap: 0.75rem;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}
	.logo-img {
		height: 36px;
		width: auto;
		object-fit: contain;
	}
	.logo-text {
		font-weight: 900;
		color: var(--primary);
		font-size: 1rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.nav {
		display: flex;
		gap: 1rem;
		align-items: center;
	}
	.nav a {
		text-decoration: none;
		color: #475569;
		font-weight: 700;
		font-size: 0.9rem;
		transition: color 0.2s;
	}
	.nav a:hover {
		color: var(--primary);
	}

	/* スマートフォン用のスタイル調整 (画面幅 640px 以下) */
	@media (max-width: 640px) {
		.header-container {
			flex-direction: column; /* 縦並びにする */
			justify-content: center;
			text-align: center;
			padding-top: 0.5rem;
			padding-bottom: 0.5rem;
		}
		.logo-text {
			font-size: 0.95rem; /* スマホ用に少し小さく */
		}
		.nav {
			gap: 1.25rem;
			margin-top: 0.25rem;
		}
		.nav a {
			font-size: 0.85rem;
		}
	}

	.site-footer {
		text-align: center;
		padding: 2rem 0;
		color: #64748b;
		font-size: 0.85rem;
		border-top: 1px solid #e2e8f0;
		background: #ffffff;
		margin-top: 3rem;
	}
</style>
