---
interface Props {
	title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

// 現在表示しているページのパスを取得
const currentPath = Astro.url.pathname;

// アクティブ判定関数
const isActive = (path: string) => {
	const target = `${baseUrl}${path}`.replace(/\/+/g, '/');
	if (path === '') {
		return currentPath === baseUrl || currentPath === `${baseUrl}/`;
	}
	return currentPath.includes(target);
};

// 対応言語リスト
const languages = [
	{ code: 'ja', label: '日本語', native: '日本語' },
	{ code: 'en', label: 'English', native: 'English' },
	{ code: 'zh-TW', label: '繁體中文', native: '繁體中文' },
	{ code: 'zh-CN', label: '简体中文', native: '简体中文' },
	{ code: 'ko', label: '한국어', native: '한국어' },
	{ code: 'es', label: 'Español', native: 'Español' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="google-site-verification" content="KVn6U5oa5V8dqifZuNdJjkbSLWu8OtQqopHZuMZgKLo" />
		<link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<!-- 背景クリスタルレイヤー -->
		<div class="crystal-background" aria-hidden="true">
			<div class="crystal-facet facet-1"></div>
			<div class="crystal-facet facet-2"></div>
			<div class="crystal-facet facet-3"></div>
			<div class="crystal-facet facet-4"></div>
		</div>

		<header class="site-header">
			<div class="container header-container">
				<a href={baseUrl} class="logo-link notranslate">
					<img 
						src={`${baseUrl}logo.png`} 
						alt="Logo" 
						class="logo-img" 
					/>
					<span class="logo-text">海のサインプロジェクト</span>
				</a>

				<!-- 右側アクション（地球マーク言語切替 ＋ モバイル用ハンバーガー） -->
				<div class="header-right notranslate">
					<!-- 地球マーク 言語切替ボタン -->
					<div class="lang-switcher" id="langSwitcher">
						<button 
							type="button" 
							class="lang-btn" 
							id="langBtn" 
							aria-label="言語切替 / Language Switcher"
							aria-haspopup="true"
							aria-expanded="false"
						>
							<span class="globe-icon" aria-hidden="true">🌐</span>
							<span class="current-lang-text" id="currentLangLabel">JA</span>
							<span class="dropdown-arrow">▾</span>
						</button>

						<!-- ドロップダウンメニュー -->
						<div class="lang-dropdown" id="langDropdown" role="menu">
							<div class="lang-dropdown-header">LANGUAGE / 言語</div>
							<div class="lang-list">
								{languages.map((lang) => (
									<button 
										type="button" 
										class={`lang-option ${lang.code === 'ja' ? 'active' : ''}`}
										data-lang={lang.code}
										data-label={lang.code.toUpperCase().split('-')[0]}
										role="menuitem"
									>
										<span class="lang-name">{lang.native}</span>
										<span class="lang-code">{lang.code.toUpperCase()}</span>
									</button>
								))}
							</div>
						</div>
					</div>

					<!-- ハンバーガー切り替えボタン（SP専用） -->
					<button class="hamburger-btn" id="menuToggle" aria-label="メニューを開閉する" aria-expanded="false">
						<span class="bar"></span>
						<span class="bar"></span>
						<span class="bar"></span>
					</button>
				</div>

				<!-- ナビゲーションメニュー -->
				<nav class="nav" id="siteNav">
					<a href={baseUrl} class:list={["nav-item", { active: isActive('') }]}>TOP</a>
					<a href={`${baseUrl}about/`} class:list={["nav-item", { active: isActive('about') }]}>ABOUT</a>
					<a href={`${baseUrl}sponsor/`} class:list={["nav-item", { active: isActive('sponsor') }]}>PARTNER</a>
					<a href={`${baseUrl}poster/`} class:list={["nav-item", { active: isActive('poster') }]}>POSTER</a>
					<a href={`${baseUrl}sns/`} class:list={["nav-item", { active: isActive('sns') }]}>SNS</a>
					<a href={`${baseUrl}contact/`} class:list={["nav-item", "nav-item-cta", { active: isActive('contact') }]}>CONTACT</a>
				</nav>
			</div>
		</header>

		<main class="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-container">
				<p class="copyright notranslate">&copy; 海のサインプロジェクト Created by <a href="https://nagoyc.stki.org/" target="_blank" rel="noopener noreferrer">NYC</a> / Developer <a href="https://sites.google.com/view/meisi1/meisi" target="_blank" rel="noopener noreferrer">Jinn</a> All rights reserved.</p>
			</div>
		</footer>

		<!-- 隠しGoogle翻訳エレメント -->
		<div id="google_translate_element" style="display:none !important;"></div>
		<script type="text/javascript">
			function googleTranslateElementInit() {
				// @ts-ignore
				new google.translate.TranslateElement({
					pageLanguage: 'ja',
					includedLanguages: 'ja,en,zh-TW,zh-CN,ko,es',
					autoDisplay: false
				}, 'google_translate_element');
			}
		</script>
		<script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

		<script>
			// ─── RSS 取得処理（CORSエラー回避プロキシ経由） ───
			async function fetchRssFeed() {
				const targetFeed = 'https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/feed/';
				// CORSブロックを回避するため allorigins プロキシを使用
				const proxyUrl = `https://api.allorigins.win/get?url=${encodeURIComponent(targetFeed)}`;

				try {
					const res = await fetch(proxyUrl);
					if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
					const data = await res.json();
					
					if (data && data.contents) {
						const parser = new DOMParser();
						const xmlDoc = parser.parseFromString(data.contents, "text/xml");
						const items = xmlDoc.querySelectorAll("item");
						// RSSアイテムの取得成功時のカスタムイベントを発行
						window.dispatchEvent(new CustomEvent('rssLoaded', { detail: { items } }));
					}
				} catch (e) {
					console.error("RSS読み込みエラー:", e);
				}
			}
			fetchRssFeed();

			// ─── 言語切替制御 ───
			const langBtn = document.getElementById('langBtn');
			const langDropdown = document.getElementById('langDropdown');
			const langSwitcher = document.getElementById('langSwitcher');
			const currentLangLabel = document.getElementById('currentLangLabel');
			const langOptions = document.querySelectorAll('.lang-option');

			function getCookie(name: string) {
				const v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
				return v ? v[2] : null;
			}

			function removeGoogleTranslateCookies() {
				const hostname = window.location.hostname;
				const domainParts = hostname.split('.');
				const domains = ['', hostname, `.${hostname}`];

				for (let i = 0; i < domainParts.length - 1; i++) {
					const rootDomain = domainParts.slice(i).join('.');
					domains.push(rootDomain);
					domains.push(`.${rootDomain}`);
				}

				const paths = ['/', window.location.pathname];

				domains.forEach((dom) => {
					paths.forEach((p) => {
						const domainAttr = dom ? `; domain=${dom}` : '';
						document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=${p}${domainAttr};`;
						document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=${p};`;
					});
				});
			}

			// ─── Safari 対策（translate.goog） ───
			const PROXY_SUFFIX = '.translate.goog';
			const PROXY_PARAMS = ['_x_tr_sl', '_x_tr_tl', '_x_tr_hl', '_x_tr_pto'];
			const isProxyPage = window.location.hostname.endsWith(PROXY_SUFFIX);
			const canUseProxy = !['localhost', '127.0.0.1', '[::1]'].includes(window.location.hostname);

			function toProxyHost(host: string) {
				return host.replace(/-/g, '--').replace(/\./g, '-') + PROXY_SUFFIX;
			}
			function fromProxyHost(host: string) {
				return host
					.slice(0, -PROXY_SUFFIX.length)
					.split('--')
					.map((part) => part.replace(/-/g, '.'))
					.join('-');
			}
			function proxyUrl(lang: string) {
				const url = new URL(window.location.href);
				if (!isProxyPage) url.hostname = toProxyHost(url.hostname);
				url.protocol = 'https:';
				url.port = '';
				PROXY_PARAMS.forEach((key) => url.searchParams.delete(key));
				url.searchParams.set('_x_tr_sl', 'ja');
				url.searchParams.set('_x_tr_tl', lang);
				url.searchParams.set('_x_tr_hl', lang);
				url.searchParams.set('_x_tr_pto', 'wapp');
				return url.toString();
			}
			function originalUrl() {
				const url = new URL(window.location.href);
				url.hostname = fromProxyHost(url.hostname);
				PROXY_PARAMS.forEach((key) => url.searchParams.delete(key));
				url.searchParams.set('lang', 'ja');
				return url.toString();
			}
			function kanaCount() {
				const text = Array.from(document.querySelectorAll('main h2, main h3, main p'))
					.slice(0, 20)
					.map((el) => el.textContent ?? '')
					.join('');
				return (text.match(/[぀-ヿ]/g) || []).length;
			}
			let fallbackTimer: number | undefined;
			function watchTranslation(lang: string) {
				if (!canUseProxy || isProxyPage) return;
				window.clearInterval(fallbackTimer);
				const start = kanaCount();
				if (start < 20) return;
				let waited = 0;
				fallbackTimer = window.setInterval(() => {
					waited += 500;
					if (kanaCount() < start * 0.3) {
						window.clearInterval(fallbackTimer);
					} else if (waited >= 6000) {
						window.clearInterval(fallbackTimer);
						window.location.href = proxyUrl(lang);
					}
				}, 500);
			}

			const pageParams = new URLSearchParams(window.location.search);
			if (!isProxyPage && pageParams.get('lang') === 'ja') {
				removeGoogleTranslateCookies();
				pageParams.delete('lang');
				const query = pageParams.toString();
				window.history.replaceState(null, '', window.location.pathname + (query ? `?${query}` : '') + window.location.hash);
			}

			const savedLangCookie = getCookie('googtrans');
			const proxyLang = isProxyPage ? pageParams.get('_x_tr_tl') : null;
			if ((proxyLang || savedLangCookie) && currentLangLabel) {
				const langParts = (proxyLang ?? savedLangCookie ?? '').split('/');
				const langCode = langParts[langParts.length - 1];
				if (langCode && langCode !== 'ja') {
					if (!proxyLang) watchTranslation(langCode);
					currentLangLabel.textContent = langCode.toUpperCase().split('-')[0];
					langOptions.forEach(opt => {
						if (opt.getAttribute('data-lang') === langCode) {
							langOptions.forEach(o => o.classList.remove('active'));
							opt.classList.add('active');
						}
					});
				}
			}

			if (langBtn && langDropdown) {
				langBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					const isOpen = langDropdown.classList.toggle('is-open');
					langBtn.setAttribute('aria-expanded', String(isOpen));
				});

				document.addEventListener('click', (e) => {
					if (langSwitcher && !langSwitcher.contains(e.target as Node)) {
						langDropdown.classList.remove('is-open');
						langBtn.setAttribute('aria-expanded', 'false');
					}
				});

				langOptions.forEach((option) => {
					option.addEventListener('click', () => {
						const targetLang = option.getAttribute('data-lang');
						const label = option.getAttribute('data-label');

						langOptions.forEach(opt => opt.classList.remove('active'));
						option.classList.add('active');
						if (currentLangLabel && label) {
							currentLangLabel.textContent = label;
						}

						if (isProxyPage && targetLang) {
							window.location.href = targetLang === 'ja' ? originalUrl() : proxyUrl(targetLang);
							return;
						}

						if (targetLang === 'ja') {
							window.clearInterval(fallbackTimer);
							const select = document.querySelector('.goog-te-combo') as HTMLSelectElement;
							if (select) {
								select.value = 'ja';
								select.dispatchEvent(new Event('change'));
							}

							const restoreBtn = document.querySelector('.goog-te-banner-frame')?.contentWindow?.document?.getElementById(':1.restore') as HTMLElement | null;
							if (restoreBtn) {
								restoreBtn.click();
							}

							removeGoogleTranslateCookies();
							setTimeout(() => {
								window.location.reload();
							}, 120);
						} else {
							const select = document.querySelector('.goog-te-combo') as HTMLSelectElement;
							if (select && targetLang) {
								select.value = targetLang;
								select.dispatchEvent(new Event('change'));
								watchTranslation(targetLang);
							} else if (!select && targetLang && canUseProxy) {
								window.location.href = proxyUrl(targetLang);
							}
						}

						langDropdown.classList.remove('is-open');
						langBtn.setAttribute('aria-expanded', 'false');
					});
				});
			}

			// ─── ハンバーガーメニュー開閉制御 ───
			const toggleBtn = document.getElementById('menuToggle');
			const nav = document.getElementById('siteNav');

			if (toggleBtn && nav) {
				toggleBtn.addEventListener('click', () => {
					const isOpen = nav.classList.toggle('is-open');
					toggleBtn.classList.toggle('is-active', isOpen);
					toggleBtn.setAttribute('aria-expanded', String(isOpen));
				});

				nav.querySelectorAll('.nav-item').forEach((link) => {
					link.addEventListener('click', () => {
						nav.classList.remove('is-open');
						toggleBtn.classList.remove('is-active');
						toggleBtn.setAttribute('aria-expanded', 'false');
					});
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--primary: #0284c7;
		--primary-hover: #0369a1;
		--accent-bg: #f0f9ff;
		--text: #1e293b;
		--text-muted: #64748b;
		--bg: #f8fafc;
		--border: #e2e8f0;
		--ocean-gradient: radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%);
		--shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.05);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		overflow-x: hidden;
	}

	body {
		top: 0 !important;
		font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		color: var(--text);
		background: var(--bg);
		line-height: 1.7;
		letter-spacing: 0.03em;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		position: relative;
	}

	.goog-te-banner-frame,
	.skiptranslate,
	#goog-gt-tt {
		display: none !important;
		visibility: hidden !important;
	}

	.crystal-background {
		position: fixed;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}

	.crystal-facet {
		position: absolute;
		opacity: 0.35;
		filter: blur(45px);
		animation: crystalFloat 18s ease-in-out infinite alternate;
	}

	.facet-1 {
		width: 420px;
		height: 420px;
		top: -100px;
		left: -80px;
		background: linear-gradient(135deg, #38bdf8 0%, #2dd4bf 50%, #818cf8 100%);
		clip-path: polygon(50% 0%, 90% 25%, 100% 75%, 65% 100%, 15% 85%, 0% 35%);
		animation-duration: 20s;
	}

	.facet-2 {
		width: 500px;
		height: 500px;
		top: 25%;
		right: -140px;
		background: linear-gradient(225deg, #0284c7 0%, #a855f7 60%, #38bdf8 100%);
		clip-path: polygon(30% 0%, 80% 15%, 100% 60%, 70% 95%, 20% 100%, 0% 50%);
		animation-duration: 26s;
		animation-delay: -5s;
	}

	.facet-3 {
		width: 460px;
		height: 460px;
		bottom: -120px;
		left: 15%;
		background: linear-gradient(45deg, #0ea5e9 0%, #3b82f6 50%, #06b6d4 100%);
		clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);
		animation-duration: 22s;
		animation-delay: -10s;
	}

	.facet-4 {
		width: 320px;
		height: 320px;
		top: 55%;
		left: 5%;
		background: linear-gradient(120deg, #c084fc 0%, #38bdf8 70%, #67e8f9 100%);
		clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
		animation-duration: 16s;
		animation-delay: -3s;
		opacity: 0.25;
	}

	@keyframes crystalFloat {
		0% {
			transform: translate(0, 0) rotate(0deg) scale(0.95);
		}
		50% {
			transform: translate(30px, 40px) rotate(15deg) scale(1.08);
		}
		100% {
			transform: translate(-25px, 20px) rotate(-10deg) scale(1);
		}
	}

	.main-content {
		flex: 1;
		position: relative;
		z-index: 1;
		animation: pageFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes pageFadeIn {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.card,
	.policy-card,
	.sns-card,
	.coming-card {
		background: rgba(255, 255, 255, 0.88) !important;
		backdrop-filter: blur(14px) !important;
		-webkit-backdrop-filter: blur(14px) !important;
		border: 1px solid rgba(255, 255, 255, 0.9) !important;
		box-shadow: 0 10px 30px -8px rgba(2, 132, 199, 0.08), 
		            0 0 0 1px rgba(226, 232, 240, 0.6) !important;
		position: relative;
		overflow: hidden;
		animation: cardFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.card::before,
	.coming-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: -150%;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			115deg,
			transparent 0%,
			rgba(255, 255, 255, 0.6) 45%,
			rgba(56, 189, 248, 0.2) 50%,
			transparent 60%
		);
		transform: skewX(-20deg);
		transition: 0.75s ease;
		pointer-events: none;
	}

	.card:hover::before,
	.coming-card:hover::before {
		left: 150%;
	}

	@keyframes cardFadeUp {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.container {
		width: 100%;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.site-header {
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow: 0 4px 20px rgba(2, 132, 199, 0.04);
		position: sticky;
		top: 0;
		z-index: 50;
		transition: all 0.3s ease;
	}

	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 72px;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		flex-shrink: 0;
		transition: opacity 0.2s ease;
		z-index: 60;
	}

	.logo-link:hover {
		opacity: 0.85;
	}

	.logo-img {
		height: 38px;
		width: auto;
		object-fit: contain;
		transition: transform 0.2s ease;
	}

	.logo-link:hover .logo-img {
		transform: rotate(-4deg) scale(1.05);
	}

	.logo-text {
		font-weight: 700;
		color: var(--primary);
		font-size: 1.05rem;
		letter-spacing: 0.02em;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		z-index: 60;
	}

	.lang-switcher {
		position: relative;
	}

	.lang-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(226, 232, 240, 0.9);
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		cursor: pointer;
		font-size: 0.8rem;
		font-weight: 700;
		color: #334155;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
		transition: all 0.2s ease;
	}

	.lang-btn:hover {
		background: #e0f2fe;
		border-color: #bae6fd;
		color: var(--primary);
		transform: translateY(-1px);
	}

	.globe-icon {
		font-size: 1rem;
		line-height: 1;
	}

	.current-lang-text {
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}

