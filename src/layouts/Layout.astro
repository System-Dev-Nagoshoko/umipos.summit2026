---
interface Props {
	title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL; // 例: "/umipos.summit2026/"
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-container">
				<a href={baseUrl} class="logo">Nago Youth Future Summit</a>
				<nav class="nav">
					<a href={baseUrl}>TOP</a>
					<a href={`${baseUrl}about/`}>ABOUT</a>
					<a href={`${baseUrl}sns/`}>SNS</a>
					<a href={`${baseUrl}contact/`}>CONTACT</a>
				</nav>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="container">
				<p>&copy; 2026 Nago Youth Future Summit & うみポス</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--primary: #0284c7;
		--text: #0f172a;
		--bg: #f8fafc;
	}
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	body {
		/* フォントを Noto Sans JP に変更 */
		font-family: 'Noto Sans JP', sans-serif;
		color: var(--text);
		background: var(--bg);
		line-height: 1.6;
	}
	/* ページ全体の見出し（h1, h2など）をより力強くイベントらしく */
	h1, h2, h3 {
		font-weight: 900; /* 最も太いウェイト */
		letter-spacing: -0.02em; /* わずかに詰めて力強さを出す */
	}
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.site-header {
		background: #ffffff;
		border-bottom: 1px solid #e2e8f0;
		position: sticky;
		top: 0;
		z-index: 50;
	}
	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 70px; /* フォントが太くなったので少し高さを調整 */
	}
	.logo {
		font-weight: 900; /* ロゴも力強く */
		color: var(--primary);
		text-decoration: none;
		font-size: 1.2rem;
		letter-spacing: -0.01em;
	}
	.nav {
		display: flex;
		gap: 1.5rem;
	}
	.nav a {
		text-decoration: none;
		color: #475569;
		font-weight: 700; /* メニューも少し太くして視認性アップ */
		font-size: 1rem;
		transition: color 0.2s;
	}
	.nav a:hover {
		color: var(--primary);
	}
	.site-footer {
		text-align: center;
		padding: 2.5rem 0;
		color: #64748b;
		font-size: 0.9rem;
		border-top: 1px solid #e2e8f0;
		background: #ffffff;
		margin-top: 4rem;
	}
</style>
