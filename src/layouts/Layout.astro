---
interface Props {
	title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

// 現在表示しているページのパスを取得
const currentPath = Astro.url.pathname;

// アクティブ判定関数
const isActive = (path: string) => {
	const target = `${baseUrl}${path}`.replace(/\/+/g, '/');
	if (path === '') {
		return currentPath === baseUrl || currentPath === `${baseUrl}/`;
	}
	return currentPath.includes(target);
};
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="google-site-verification" content="KVn6U5oa5V8dqifZuNdJjkbSLWu8OtQqopHZuMZgKLo" />
		<link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-container">
				<a href={baseUrl} class="logo-link">
					<img src={`${baseUrl}logo.png`} alt="Logo" class="logo-img" />
					<span class="logo-text">海のサインプロジェクト</span>
				</a>

				<!-- ハンバーガー切り替えボタン（SP専用） -->
				<button class="hamburger-btn" id="menuToggle" aria-label="メニューを開閉する" aria-expanded="false">
					<span class="bar"></span>
					<span class="bar"></span>
					<span class="bar"></span>
				</button>

				<!-- ナビゲーションメニュー -->
				<nav class="nav" id="siteNav">
					<a href={baseUrl} class:list={["nav-item", { active: isActive('') }]}>TOP</a>
					<a href={`${baseUrl}about/`} class:list={["nav-item", { active: isActive('about') }]}>ABOUT</a>
					<a href={`${baseUrl}event/`} class:list={["nav-item", { active: isActive('event') }]}>EVENT</a>
					<a href={`${baseUrl}sponsor/`} class:list={["nav-item", { active: isActive('sponsor') }]}>PARTNER</a>
					<a href={`${baseUrl}poster/`} class:list={["nav-item", { active: isActive('poster') }]}>POSTER</a>
					<a href={`${baseUrl}sns/`} class:list={["nav-item", { active: isActive('sns') }]}>SNS</a>
					<a href={`${baseUrl}contact/`} class:list={["nav-item", "nav-item-cta", { active: isActive('contact') }]}>CONTACT</a>
				</nav>
			</div>
		</header>

		<main class="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-container">
				<p class="copyright">&copy; 2026 Nago Youth Future Summit & 海のサインプロジェクト All rights reserved.</p>
			</div>
		</footer>

		<script>
			// ハンバーガーメニュー開閉制御
			const toggleBtn = document.getElementById('menuToggle');
			const nav = document.getElementById('siteNav');

			if (toggleBtn && nav) {
				toggleBtn.addEventListener('click', () => {
					const isOpen = nav.classList.toggle('is-open');
					toggleBtn.classList.toggle('is-active', isOpen);
					toggleBtn.setAttribute('aria-expanded', String(isOpen));
				});

				// メニュー内のリンククリックで自動的にメニューを閉じる
				nav.querySelectorAll('.nav-item').forEach((link) => {
					link.addEventListener('click', () => {
						nav.classList.remove('is-open');
						toggleBtn.classList.remove('is-active');
						toggleBtn.setAttribute('aria-expanded', 'false');
					});
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--primary: #0284c7;
		--primary-hover: #0369a1;
		--accent-bg: #f0f9ff;
		--text: #1e293b;
		--text-muted: #64748b;
		--bg: #fafafa;
		--border: #e2e8f0;
		--shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.05);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		overflow-x: hidden;
	}

	body {
		font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		color: var(--text);
		background: var(--bg);
		line-height: 1.7;
		letter-spacing: 0.03em;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.main-content {
		flex: 1;
	}

	.container {
		width: 100%;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* ヘッダー構造（ガラスモフィズム） */
	.site-header {
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(226, 232, 240, 0.8);
		position: sticky;
		top: 0;
		z-index: 50;
		transition: all 0.3s ease;
	}

	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 72px;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		flex-shrink: 0;
		transition: opacity 0.2s ease;
		z-index: 60;
	}

	.logo-link:hover {
		opacity: 0.85;
	}

	.logo-img {
		height: 38px;
		width: auto;
		object-fit: contain;
	}

	.logo-text {
		font-weight: 700;
		color: var(--primary);
		font-size: 1.05rem;
		letter-spacing: 0.02em;
	}

	.nav {
		display: flex;
		gap: 0.35rem;
		align-items: center;
	}

	/* 通常のナビ項目 */
	.nav-item,
	.nav-item:visited {
		text-decoration: none;
		color: var(--text-muted);
		font-weight: 700;
		font-size: 0.85rem;
		padding: 0.5rem 0.85rem;
		border-radius: 9999px;
		transition: all 0.2s ease;
	}

	.nav-item:hover {
		color: var(--primary);
		background-color: var(--accent-bg);
	}

	/* 通常メニューのアクティブ状態 */
	.nav-item.active:not(.nav-item-cta) {
		color: var(--primary);
		background-color: #e0f2fe;
		font-weight: 900;
	}

	/* CONTACTボタン */
	.nav-item-cta,
	.nav-item-cta:visited {
		border: 1.5px solid var(--primary);
		color: var(--primary) !important;
		background-color: transparent;
		margin-left: 0.35rem;
	}

	.nav-item-cta:hover {
		background-color: var(--accent-bg);
		transform: translateY(-1px);
	}

	.nav-item-cta.active {
		background-color: var(--primary) !important;
		color: #ffffff !important;
		box-shadow: 0 2px 10px rgba(2, 132, 199, 0.25);
	}

	/* ハンバーガーアイコン（PC時は非表示） */
	.hamburger-btn {
		display: none;
		flex-direction: column;
		justify-content: space-around;
		width: 32px;
		height: 28px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 60;
	}

	.hamburger-btn .bar {
		width: 100%;
		height: 3px;
		background-color: var(--primary);
		border-radius: 9999px;
		transition: all 0.3s ease;
	}

	/* ハンバーガーがactiveになったときのバツ印アニメーション */
	.hamburger-btn.is-active .bar:nth-child(1) {
		transform: translateY(9px) rotate(45deg);
	}
	.hamburger-btn.is-active .bar:nth-child(2) {
		opacity: 0;
	}
	.hamburger-btn.is-active .bar:nth-child(3) {
		transform: translateY(-9px) rotate(-45deg);
	}

	/* フッター構造 */
	.site-footer {
		text-align: center;
		padding: 3rem 0;
		color: var(--text-muted);
		font-size: 0.85rem;
		border-top: 1px solid var(--border);
		background: #ffffff;
		margin-top: 4rem;
	}

	.copyright {
		line-height: 1.8;
	}

	/* スマホ・タブレット（768px以下）用レイアウト */
	@media (max-width: 768px) {
		.hamburger-btn {
			display: flex;
		}

		.nav {
			position: fixed;
			top: 0;
			right: -100%;
			width: 100%;
			height: 100vh;
			background: rgba(255, 255, 255, 0.98);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 1.25rem;
			padding: 2rem;
			transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			z-index: 55;
		}

		.nav.is-open {
			right: 0;
		}

		.nav-item {
			font-size: 1.15rem;
			padding: 0.6rem 2rem;
			width: auto;
			text-align: center;
		}

		.nav-item-cta,
		.nav-item-cta:visited {
			margin-left: 0;
			margin-top: 0.5rem;
			width: min(220px, 80%);
			text-align: center;
			padding: 0.75rem 0;
		}
	}
</style>
