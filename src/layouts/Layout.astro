---
interface Props {
	title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

// 現在表示しているページのパスを取得
const currentPath = Astro.url.pathname;

// アクティブ判定関数
const isActive = (path: string) => {
	const target = `${baseUrl}${path}`.replace(/\/+/g, '/');
	if (path === '') {
		return currentPath === baseUrl || currentPath === `${baseUrl}/`;
	}
	return currentPath.includes(target);
};
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-container">
				<a href={baseUrl} class="logo-link">
					<img 
						src={`${baseUrl}logo.png`} 
						alt="Logo" 
						class="logo-img" 
					/>
					<span class="logo-text">海のサインプロジェクト</span>
				</a>

				<nav class="nav">
					<a 
						href={baseUrl} 
						class:list={["nav-item", { active: isActive('') }]}
					>
						TOP
					</a>
					<a 
						href={`${baseUrl}about/`} 
						class:list={["nav-item", { active: isActive('about') }]}
					>
						ABOUT
					</a>
					<a 
						href={`${baseUrl}event/`} 
						class:list={["nav-item", { active: isActive('event') }]}
					>
						EVENT
					</a>
					<a 
						href={`${baseUrl}sns/`} 
						class:list={["nav-item", { active: isActive('sns') }]}
					>
						SNS
					</a>
					<a 
						href={`${baseUrl}contact/`} 
						class:list={["nav-item", "nav-item-cta", { active: isActive('contact') }]}
					>
						CONTACT
					</a>
				</nav>
			</div>
		</header>

		<main class="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-container">
				<p class="copyright">&copy; 2026 Nago Youth Future Summit & 海のサインプロジェクト All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--primary: #0284c7;
		--primary-hover: #0369a1;
		--accent-bg: #f0f9ff;
		--text: #1e293b;
		--text-muted: #64748b;
		--bg: #fafafa;
		--border: #e2e8f0;
		--shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.05);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		overflow-x: hidden;
	}

	body {
		font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		color: var(--text);
		background: var(--bg);
		line-height: 1.7;
		letter-spacing: 0.03em;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.main-content {
		flex: 1;
	}

	.container {
		width: 100%;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* ヘッダー構造（ガラスモフィズム） */
	.site-header {
		background: rgba(255, 255, 255, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(226, 232, 240, 0.8);
		position: sticky;
		top: 0;
		z-index: 50;
		transition: all 0.3s ease;
	}

	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 72px;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		flex-shrink: 0;
		transition: opacity 0.2s ease;
	}

	.logo-link:hover {
		opacity: 0.85;
	}

	.logo-img {
		height: 38px;
		width: auto;
		object-fit: contain;
	}

	.logo-text {
		font-weight: 700;
		color: var(--primary);
		font-size: 1.05rem;
		letter-spacing: 0.02em;
	}

	.nav {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}

	/* 通常のナビ項目 */
	.nav-item,
	.nav-item:visited {
		text-decoration: none;
		color: var(--text-muted);
		font-weight: 700;
		font-size: 0.875rem;
		padding: 0.5rem 1rem;
		border-radius: 9999px;
		transition: all 0.2s ease;
	}

	.nav-item:hover {
		color: var(--primary);
		background-color: var(--accent-bg);
	}

	/* 通常メニューのアクティブ状態 */
	.nav-item.active:not(.nav-item-cta) {
		color: var(--primary);
		background-color: #e0f2fe;
		font-weight: 900;
	}

	/* CONTACTボタン */
	.nav-item-cta,
	.nav-item-cta:visited {
		border: 1.5px solid var(--primary);
		color: var(--primary) !important;
		background-color: transparent;
		margin-left: 0.5rem;
	}

	.nav-item-cta:hover {
		background-color: var(--accent-bg);
		transform: translateY(-1px);
	}

	/* CONTACTページが開いている時のみ塗りつぶし表示 */
	.nav-item-cta.active {
		background-color: var(--primary) !important;
		color: #ffffff !important;
		box-shadow: 0 2px 10px rgba(2, 132, 199, 0.25);
	}

	/* フッター構造 */
	.site-footer {
		text-align: center;
		padding: 3rem 0;
		color: var(--text-muted);
		font-size: 0.85rem;
		border-top: 1px solid var(--border);
		background: #ffffff;
		margin-top: 4rem;
	}

	.copyright {
		line-height: 1.8;
	}

	/* レスポンシブ調整 */
	@media (max-width: 640px) {
		.header-container {
			height: auto;
			padding-top: 0.875rem;
			padding-bottom: 0.875rem;
			flex-direction: column;
			gap: 0.75rem;
		}

		.nav {
			width: 100%;
			justify-content: center;
			gap: 0.25rem;
			flex-wrap: wrap;
		}

		.nav-item {
			padding: 0.4rem 0.6rem;
			font-size: 0.775rem;
		}

		.nav-item-cta {
			margin-left: 0;
		}
	}
</style>
