---
interface Props {
	title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

// 現在のパスを取得
const currentPath = Astro.url.pathname;

// 対応主要言語リスト
const supportedLanguages = [
	{ code: 'ja', label: '日本語', prefix: '' },
	{ code: 'en', label: 'English', prefix: 'en' },
	{ code: 'zh-tw', label: '繁體中文', prefix: 'zh-tw' },
	{ code: 'zh-cn', label: '简体中文', prefix: 'zh-cn' },
	{ code: 'ko', label: '한국어', prefix: 'ko' },
	{ code: 'es', label: 'Español', prefix: 'es' },
];

// 現在のロケール判定（URLから判定）
const pathSegments = currentPath.replace(baseUrl, '').split('/').filter(Boolean);
const currentLocale = supportedLanguages.some(l => l.code === pathSegments[0]?.toLowerCase())
	? pathSegments[0].toLowerCase()
	: 'ja';

// 現在のロケールプレフィックスを除いた基本パスを抽出
const cleanSegments = currentLocale === 'ja' ? pathSegments : pathSegments.slice(1);
const rawPagePath = cleanSegments.join('/');

// 各言語への切り替えURLを生成する関数
const getLocalizedPath = (langPrefix: string) => {
	const prefixPart = langPrefix ? `${langPrefix}/` : '';
	const pagePart = rawPagePath ? `${rawPagePath}/` : '';
	return `${baseUrl}${prefixPart}${pagePart}`.replace(/\/+/g, '/');
};

// ナビゲーションのアクティブ判定関数
const isActive = (pageSlug: string) => {
	if (pageSlug === '') {
		return rawPagePath === '';
	}
	return rawPagePath.startsWith(pageSlug);
};

// ナビリンクURL生成（現在の言語を維持）
const navUrl = (pageSlug: string) => {
	const prefixPart = currentLocale === 'ja' ? '' : `${currentLocale}/`;
	const slugPart = pageSlug ? `${pageSlug}/` : '';
	return `${baseUrl}${prefixPart}${slugPart}`.replace(/\/+/g, '/');
};
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="google-site-verification" content="KVn6U5oa5V8dqifZuNdJjkbSLWu8OtQqopHZuMZgKLo" />
		<link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<!-- ▼ クリスタル背景レイヤー ▼ -->
		<div class="crystal-background" aria-hidden="true">
			<div class="crystal-facet facet-1"></div>
			<div class="crystal-facet facet-2"></div>
			<div class="crystal-facet facet-3"></div>
			<div class="crystal-facet facet-4"></div>
		</div>

		<header class="site-header">
			<div class="container header-container">
				<a href={navUrl('')} class="logo-link">
					<img 
						src={`${baseUrl}logo.png`} 
						alt="Logo" 
						class="logo-img" 
					/>
					<span class="logo-text">海のサインプロジェクト</span>
				</a>

				<!-- 右側アクション（地球マーク言語切替 ＋ モバイル用ハンバーガー） -->
				<div class="header-right">
					<!-- 地球マーク 言語切替メニュー -->
					<div class="lang-switcher" id="langSwitcher">
						<button 
							type="button" 
							class="lang-btn" 
							id="langBtn" 
							aria-label="言語切替 / Language Switcher"
							aria-haspopup="true"
							aria-expanded="false"
						>
							<span class="globe-icon" aria-hidden="true">🌐</span>
							<span class="current-lang-text">{currentLocale.toUpperCase()}</span>
							<span class="dropdown-arrow">▾</span>
						</button>

						<!-- ドロップダウンリンク -->
						<div class="lang-dropdown" id="langDropdown" role="menu">
							<div class="lang-dropdown-header">LANGUAGE</div>
							<div class="lang-list">
								{supportedLanguages.map((lang) => (
									<a 
										href={getLocalizedPath(lang.prefix)}
										class:list={["lang-option", { active: currentLocale === lang.code }]}
										role="menuitem"
									>
										<span class="lang-name">{lang.label}</span>
										<span class="lang-code">{lang.code.toUpperCase()}</span>
									</a>
								))}
							</div>
						</div>
					</div>

					<!-- ハンバーガー切り替えボタン（モバイル専用） -->
					<button class="hamburger-btn" id="menuToggle" aria-label="メニューを開閉する" aria-expanded="false">
						<span class="bar"></span>
						<span class="bar"></span>
						<span class="bar"></span>
					</button>
				</div>

				<!-- ナビゲーションメニュー -->
				<nav class="nav" id="siteNav">
					<a href={navUrl('')} class:list={["nav-item", { active: isActive('') }]}>TOP</a>
					<a href={navUrl('about')} class:list={["nav-item", { active: isActive('about') }]}>ABOUT</a>
					<a href={navUrl('event')} class:list={["nav-item", { active: isActive('event') }]}>EVENT</a>
					<a href={navUrl('sponsor')} class:list={["nav-item", { active: isActive('sponsor') }]}>PARTNER</a>
					<a href={navUrl('poster')} class:list={["nav-item", { active: isActive('poster') }]}>POSTER</a>
					<a href={navUrl('sns')} class:list={["nav-item", { active: isActive('sns') }]}>SNS</a>
					<a href={navUrl('contact')} class:list={["nav-item", "nav-item-cta", { active: isActive('contact') }]}>CONTACT</a>
				</nav>
			</div>
		</header>

		<main class="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-container">
				<p class="copyright">&copy; 2026 Nago Youth Future Summit & 海のサインプロジェクト All rights reserved.</p>
			</div>
		</footer>

		<script>
			// 言語切替ドロップダウンの制御
			const langBtn = document.getElementById('langBtn');
			const langDropdown = document.getElementById('langDropdown');
			const langSwitcher = document.getElementById('langSwitcher');

			if (langBtn && langDropdown) {
				langBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					const isOpen = langDropdown.classList.toggle('is-open');
					langBtn.setAttribute('aria-expanded', String(isOpen));
				});

				// 外側タップで閉じる
				document.addEventListener('click', (e) => {
					if (langSwitcher && !langSwitcher.contains(e.target as Node)) {
						langDropdown.classList.remove('is-open');
						langBtn.setAttribute('aria-expanded', 'false');
					}
				});
			}

			// ハンバーガーメニュー開閉制御
			const toggleBtn = document.getElementById('menuToggle');
			const nav = document.getElementById('siteNav');

			if (toggleBtn && nav) {
				toggleBtn.addEventListener('click', () => {
					const isOpen = nav.classList.toggle('is-open');
					toggleBtn.classList.toggle('is-active', isOpen);
					toggleBtn.setAttribute('aria-expanded', String(isOpen));
				});

				nav.querySelectorAll('.nav-item').forEach((link) => {
					link.addEventListener('click', () => {
						nav.classList.remove('is-open');
						toggleBtn.classList.remove('is-active');
						toggleBtn.setAttribute('aria-expanded', 'false');
					});
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--primary: #0284c7;
		--primary-hover: #0369a1;
		--accent-bg: #f0f9ff;
		--text: #1e293b;
		--text-muted: #64748b;
		--bg: #f8fafc;
		--border: #e2e8f0;
		--ocean-gradient: radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%);
		--shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.05);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		overflow-x: hidden;
	}

	body {
		font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		color: var(--text);
		background: var(--bg);
		line-height: 1.7;
		letter-spacing: 0.03em;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		position: relative;
	}

	/* =========================================
	   ▼ クリスタル背景レイヤーと浮遊多面体演出
	   ========================================= */
	.crystal-background {
		position: fixed;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}

	.crystal-facet {
		position: absolute;
		opacity: 0.35;
		filter: blur(45px);
		animation: crystalFloat 18s ease-in-out infinite alternate;
	}

	.facet-1 {
		width: 420px;
		height: 420px;
		top: -100px;
		left: -80px;
		background: linear-gradient(135deg, #38bdf8 0%, #2dd4bf 50%, #818cf8 100%);
		clip-path: polygon(50% 0%, 90% 25%, 100% 75%, 65% 100%, 15% 85%, 0% 35%);
		animation-duration: 20s;
	}

	.facet-2 {
		width: 500px;
		height: 500px;
		top: 25%;
		right: -140px;
		background: linear-gradient(225deg, #0284c7 0%, #a855f7 60%, #38bdf8 100%);
		clip-path: polygon(30% 0%, 80% 15%, 100% 60%, 70% 95%, 20% 100%, 0% 50%);
		animation-duration: 26s;
		animation-delay: -5s;
	}

	.facet-3 {
		width: 460px;
		height: 460px;
		bottom: -120px;
		left: 15%;
		background: linear-gradient(45deg, #0ea5e9 0%, #3b82f6 50%, #06b6d4 100%);
		clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);
		animation-duration: 22s;
		animation-delay: -10s;
	}

	.facet-4 {
		width: 320px;
		height: 320px;
		top: 55%;
		left: 5%;
		background: linear-gradient(120deg, #c084fc 0%, #38bdf8 70%, #67e8f9 100%);
		clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
		animation-duration: 16s;
		animation-delay: -3s;
		opacity: 0.25;
	}

	@keyframes crystalFloat {
		0% {
			transform: translate(0, 0) rotate(0deg) scale(0.95);
		}
		50% {
			transform: translate(30px, 40px) rotate(15deg) scale(1.08);
		}
		100% {
			transform: translate(-25px, 20px) rotate(-10deg) scale(1);
		}
	}

	/* =========================================
	   ▼ ページコンテンツ（クリスタルガラス感）
	   ========================================= */
	.main-content {
		flex: 1;
		position: relative;
		z-index: 1;
		animation: pageFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes pageFadeIn {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.card,
	.policy-card,
	.sns-card,
	.coming-card {
		background: rgba(255, 255, 255, 0.88) !important;
		backdrop-filter: blur(14px) !important;
		-webkit-backdrop-filter: blur(14px) !important;
		border: 1px solid rgba(255, 255, 255, 0.9) !important;
		box-shadow: 0 10px 30px -8px rgba(2, 132, 199, 0.08), 
		            0 0 0 1px rgba(226, 232, 240, 0.6) !important;
		position: relative;
		overflow: hidden;
		animation: cardFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.card::before,
	.coming-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: -150%;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			115deg,
			transparent 0%,
			rgba(255, 255, 255, 0.6) 45%,
			rgba(56, 189, 248, 0.2) 50%,
			transparent 60%
		);
		transform: skewX(-20deg);
		transition: 0.75s ease;
		pointer-events: none;
	}

	.card:hover::before,
	.coming-card:hover::before {
		left: 150%;
	}

	@keyframes cardFadeUp {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.container {
		width: 100%;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* ヘッダー構造 */
	.site-header {
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow: 0 4px 20px rgba(2, 132, 199, 0.04);
		position: sticky;
		top: 0;
		z-index: 50;
		transition: all 0.3s ease;
	}

	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 72px;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		flex-shrink: 0;
		transition: opacity 0.2s ease;
		z-index: 60;
	}

	.logo-link:hover {
		opacity: 0.85;
	}

	.logo-img {
		height: 38px;
		width: auto;
		object-fit: contain;
		transition: transform 0.2s ease;
	}

	.logo-link:hover .logo-img {
		transform: rotate(-4deg) scale(1.05);
	}

	.logo-text {
		font-weight: 700;
		color: var(--primary);
		font-size: 1.05rem;
		letter-spacing: 0.02em;
	}

	/* 右側アクションエリア */
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		z-index: 60;
	}

	/* ▼ 地球マーク 言語切替ボタンスタイル ▼ */
	.lang-switcher {
		position: relative;
	}

	.lang-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(226, 232, 240, 0.9);
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		cursor: pointer;
		font-size: 0.8rem;
		font-weight: 700;
		color: #334155;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
		transition: all 0.2s ease;
	}

	.lang-btn:hover {
		background: #e0f2fe;
		border-color: #bae6fd;
		color: var(--primary);
		transform: translateY(-1px);
	}

	.globe-icon {
		font-size: 1rem;
		line-height: 1;
	}

	.current-lang-text {
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}

	.dropdown-arrow {
		font-size: 0.7rem;
		color: #64748b;
	}

	/* ドロップダウンメニュー */
	.lang-dropdown {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid #e2e8f0;
		border-radius: 14px;
		box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.12);
		min-width: 170px;
		padding: 0.5rem;
		display: none;
		flex-direction: column;
		z-index: 100;
		animation: dropFadeIn 0.2s ease-out forwards;
	}

	.lang-dropdown.is-open {
		display: flex;
	}

	.lang-dropdown-header {
		font-size: 0.65rem;
		font-weight: 800;
		color: #94a3b8;
		padding: 0.25rem 0.6rem 0.4rem;
		border-bottom: 1px solid #f1f5f9;
		letter-spacing: 0.08em;
	}

	.lang-list {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin-top: 0.35rem;
	}

	@keyframes dropFadeIn {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.lang-option {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		text-decoration: none;
		font-size: 0.825rem;
		font-weight: 600;
		color: #334155;
		transition: all 0.15s ease;
	}

	.lang-option:hover {
		background: #f0f9ff;
		color: var(--primary);
	}

	.lang-option.active {
		background: #e0f2fe;
		color: var(--primary);
		font-weight: 800;
	}

	.lang-code {
		font-size: 0.68rem;
		color: #94a3b8;
		font-weight: 700;
	}

	/* ナビゲーションメニュー */
	.nav {
		display: flex;
		gap: 0.35rem;
		align-items: center;
	}

	.nav-item,
	.nav-item:visited {
		text-decoration: none;
		color: var(--text-muted);
		font-weight: 700;
		font-size: 0.85rem;
		padding: 0.5rem 0.85rem;
		border-radius: 9999px;
		transition: all 0.2s ease;
	}

	.nav-item:hover {
		color: var(--primary);
		background-color: var(--accent-bg);
	}

	.nav-item.active:not(.nav-item-cta) {
		color: var(--primary);
		background: #e0f2fe;
		font-weight: 900;
	}

	.nav-item-cta,
	.nav-item-cta:visited {
		border: 1.5px solid var(--primary);
		color: var(--primary) !important;
		background-color: transparent;
		margin-left: 0.35rem;
	}

	.nav-item-cta:hover {
		background-color: var(--accent-bg);
		transform: translateY(-1px);
	}

	.nav-item-cta.active {
		background-color: var(--primary) !important;
		color: #ffffff !important;
		box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
	}

	/* ハンバーガーアイコン */
	.hamburger-btn {
		display: none;
		flex-direction: column;
		justify-content: space-around;
		width: 32px;
		height: 28px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
	}

	.hamburger-btn .bar {
		width: 100%;
		height: 3px;
		background-color: var(--primary);
		border-radius: 9999px;
		transition: all 0.3s ease;
	}

	.hamburger-btn.is-active .bar:nth-child(1) {
		transform: translateY(9px) rotate(45deg);
	}
	.hamburger-btn.is-active .bar:nth-child(2) {
		opacity: 0;
	}
	.hamburger-btn.is-active .bar:nth-child(3) {
		transform: translateY(-9px) rotate(-45deg);
	}

	/* フッター構造 */
	.site-footer {
		text-align: center;
		padding: 3rem 0;
		color: var(--text-muted);
		font-size: 0.85rem;
		border-top: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		margin-top: 4rem;
		position: relative;
		z-index: 1;
	}

	.copyright {
		line-height: 1.8;
	}

	/* スマホ・タブレット（768px以下）用レイアウト */
	@media (max-width: 768px) {
		.hamburger-btn {
			display: flex;
		}

		.nav {
			position: fixed;
			top: 0;
			right: -100%;
			width: 100%;
			height: 100vh;
			background: rgba(255, 255, 255, 0.96);
			backdrop-filter: blur(20px);
			-webkit-backdrop-filter: blur(20px);
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 1.25rem;
			padding: 2rem;
			transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			z-index: 55;
		}

		.nav.is-open {
			right: 0;
		}

		.nav-item {
			font-size: 1.15rem;
			padding: 0.6rem 2rem;
			width: auto;
			text-align: center;
		}

		.nav-item-cta,
		.nav-item-cta:visited {
			margin-left: 0;
			margin-top: 0.5rem;
			width: min(220px, 80%);
			text-align: center;
			padding: 0.75rem 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		::before,
		::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
