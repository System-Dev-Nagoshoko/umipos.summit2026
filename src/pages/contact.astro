---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CONTACT | Nago Youth Future Summit 2026">
	<main>
		<section class="page-header">
			<div class="container">
				<h1>CONTACT</h1>
				<p>お問い合わせ</p>
			</div>
		</section>

		<section class="section">
			<div class="container flex-container">
				<div class="card">
					<h2>主催・運営組織</h2>
					
					<div class="profile-box">
						<dl class="profile-dl">
							<div>
								<dt>主催</dt>
								<dd>Nago city Youth Creative PROJECTs（NYC）</dd>
							</div>
							<div>
								<dt>協力</dt>
								<dd>名護市内外の連携団体・企業（全10団体想定）</dd>
							</div>
						</dl>
					</div>

					<div class="contact-box">
						<h3>✉️ メールでのお問い合わせ</h3>
						<p>イベントに関するご質問、取材・協賛、うみポス企画等のお問い合わせは、以下のメールアドレスまでご連絡ください。</p>
						
						<a href="mailto:nyc.summit.umipos@outlook.jp" class="email-link">
							nyc.summit.umipos@outlook.jp
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* ヘッダーセクション（ABOUTと統一） */
	.page-header {
		background: radial-gradient(circle at 50% 0%, #0284c7 0%, #0369a1 100%);
		color: white;
		padding: 4rem 0;
		text-align: center;
	}
	.page-header h1 {
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: 0.05em;
	}
	.page-header p {
		color: #93c5fd;
		font-size: 1rem;
		margin-top: 0.5rem;
	}

	/* メインコンテンツ配置 */
	.section {
		padding: 3rem 0;
	}
	.flex-container {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	/* メインカード（ABOUTと角丸・シャドウ・余白を統一） */
	.card {
		background: white;
		border-radius: 16px;
		padding: 2.5rem 2rem;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
		max-width: 800px;
		margin: 0 auto;
		width: 100%;
		border: 1px solid #f1f5f9;
	}
	.card h2 {
		font-size: 1.5rem;
		color: #0f172a;
		border-bottom: 2px solid #bae6fd;
		padding-bottom: 0.5rem;
		margin-bottom: 1.5rem;
		font-weight: 700;
	}

	/* 組織概要リスト（ABOUTのプロフィール表記スタイルと共通化） */
	.profile-box {
		margin-bottom: 2rem;
	}
	.profile-dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
		background: #f8fafc;
		padding: 1.25rem;
		border-radius: 12px;
		border: 1px solid #e2e8f0;
	}
	.profile-dl dt {
		font-size: 0.85rem;
		color: #0284c7;
		font-weight: 700;
		margin-bottom: 0.25rem;
	}
	.profile-dl dd {
		font-size: 0.95rem;
		color: #1e293b;
		font-weight: 500;
		line-height: 1.5;
	}

	/* お問い合わせボックス（ABOUTのハイライトボックス調に統一） */
	.contact-box {
		background: #f0f9ff;
		border: 1px solid #bae6fd;
		padding: 2rem 1.5rem;
		border-radius: 12px;
		text-align: center;
	}
	.contact-box h3 {
		font-size: 1.15rem;
		color: #0369a1;
		margin-bottom: 0.75rem;
		font-weight: 700;
	}
	.contact-box p {
		color: #475569;
		font-size: 0.95rem;
		margin-bottom: 1.5rem;
		line-height: 1.7;
	}

	/* メールアドレスリンク（モダンなボタン風へアップデート） */
	.email-link {
		display: inline-block;
		font-size: 1.05rem;
		font-weight: 700;
		color: #ffffff;
		background: #0284c7;
		text-decoration: none;
		padding: 0.75rem 1.75rem;
		border-radius: 9999px;
		box-shadow: 0 4px 12px rgba(2, 132, 199, 0.2);
		transition: all 0.2s ease;
		word-break: break-all;
	}
	.email-link:hover {
		background: #0369a1;
		box-shadow: 0 6px 16px rgba(2, 132, 199, 0.3);
		transform: translateY(-2px);
	}

	/* スマホサイズ調整 */
	@media (max-width: 640px) {
		.card {
			padding: 1.75rem 1.25rem;
		}
		.contact-box {
			padding: 1.5rem 1rem;
		}
		.email-link {
			font-size: 0.9rem;
			padding: 0.65rem 1.25rem;
		}
	}
</style>
