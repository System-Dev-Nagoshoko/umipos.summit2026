---
import Layout from '../layouts/Layout.astro';
---

<Layout title="海のサインプロジェクト | うみぽす甲子園2026 ファイナリスト">
	<main>
		<section class="hero">
			<div class="container hero-inner">
				<div class="badge">
					<span class="badge-dot"></span>
					うみぽす甲子園2026 ファイナリスト
				</div>
				
				<div class="hero-text-wrap">
					<h1 class="hero-catch-title">
						<span class="line-from">「見る看板」から</span>
						<span class="line-to">「<span class="highlight-aqua">伝わる看板</span>」へ</span>
					</h1>
					<p class="hero-caption">
						沖縄の海を守る「海のサインプロジェクト」始動！
					</p>
				</div>

				<!-- カウントダウンタイマー（2026年11月21日 10:00） -->
				<div class="countdown-box" id="countdown-container">
					<div class="countdown-label" id="countdown-title">🏆 うみぽす甲子園2026 決勝大会まで</div>
					<div class="countdown-grid" id="countdown-grid">
						<div class="time-unit">
							<span class="time-num" id="cd-days">--</span>
							<span class="time-text">DAYS</span>
						</div>
						<span class="time-sep">:</span>
						<div class="time-unit">
							<span class="time-num" id="cd-hours">--</span>
							<span class="time-text">HOURS</span>
						</div>
						<span class="time-sep">:</span>
						<div class="time-unit">
							<span class="time-num" id="cd-minutes">--</span>
							<span class="time-text">MINS</span>
						</div>
						<span class="time-sep">:</span>
						<div class="time-unit">
							<span class="time-num" id="cd-seconds">--</span>
							<span class="time-text">SECS</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container flex-container">
				
				<!-- チーム紹介カード -->
				<div class="card main-card">
					<div class="status-tag">TEAM PROFILE</div>
					<h2>はじめまして！「海のサインプロジェクト」です</h2>
					<p class="desc">
						私たちは、「見る看板ではなく、伝わる看板へ」をテーマに、誰もが安心して楽しめる名護の海を目指して活動している高校生チームです。
					</p>

					<div class="outline-box">
						<h3>🌊 なぜこの活動を始めたのか？</h3>
						<p class="box-desc">
							普段、何気なく見ている海岸の注意看板。実は「文字が小さくて読みづらい」「どこに危険があるのか伝わりにくい」といった課題があります。<br />
							そこで私たちは、実際に名護市の海岸を調査！子どもからお年寄りまで、国籍や年齢を問わず一目で危険が「伝わる」看板デザインを模索・制作しています。
						</p>
					</div>

					<div class="message-box">
						<h3>💡 私たちの想い</h3>
						<p>「名護市の美しい海を、みんながもっと安全に、笑顔で楽しめる場所にしたい」<br />そんな想いを込めて、メンバー一丸となって活動中です！</p>
					</div>

					<div class="info-box">
						<p>📢 今後も活動の様子や制作の裏側をブログやSNSでお届けしていきます。ぜひチェック＆応援よろしくお願いいたします！</p>
					</div>
				</div>

				<!-- 最終発表 YouTube動画カード -->
				<div class="card featured-video-card">
					<div class="video-badge-row">
						<span class="video-tag">🏆 FINAL PRESENTATION</span>
						<span class="video-sub">うみぽす甲子園2026 最終発表動画</span>
					</div>
					<h2>最終発表はこちら</h2>
					<p class="video-desc">
						私たちが取り組んできた「伝わる看板」の制作成果と想いをまとめた最終発表です。ぜひご覧ください！
					</p>

					<div class="video-wrapper">
						<iframe
							src="https://www.youtube-nocookie.com/embed/E9Af2iGSPHk?rel=0"
							title="海のサインプロジェクト 最終発表"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen
							loading="lazy"
						></iframe>
					</div>

					<div class="video-actions">
						<a
							href="https://www.youtube.com/watch?v=E9Af2iGSPHk"
							target="_blank"
							rel="noopener noreferrer"
							class="youtube-watch-btn"
						>
							YouTubeで高評価・コメントする ↗
						</a>
					</div>
				</div>

				<!-- 最新活動メディア（タブ切り替え） -->
				<div class="card blog-card">
					<div class="blog-header">
						<h2>📢 最新活動メディア</h2>
						
						<div class="tab-controls" role="tablist">
							<button type="button" class="tab-btn active" data-source="blog">明日の地図</button>
							<button type="button" class="tab-btn" data-source="note">note</button>
							<button type="button" class="tab-btn" data-source="youtube">YouTube</button>
						</div>

						<a 
							id="external-archive-link"
							href="https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/" 
							target="_blank" 
							rel="noopener noreferrer" 
							class="all-posts-link"
						>
							ブログ一覧を見る ↗
						</a>
					</div>

					<div id="blog-list-container" class="blog-list">
						<p class="loading-text">最新情報を読み込み中...</p>
					</div>
				</div>

			</div>
		</section>
	</main>
</Layout>

<script>
	// ==========================================
	// 1. カウントダウン設定（2026年11月21日 午前10:00）
	// ==========================================
	const TARGET_DATE_STR = '2026-11-21T10:00:00+09:00';
	const EVENT_ENDED_TEXT = '🎉 決勝大会開催中 / 応援ありがとうございました！';

	function initCountdown() {
		const targetTime = new Date(TARGET_DATE_STR).getTime();
		const daysEl = document.getElementById('cd-days');
		const hoursEl = document.getElementById('cd-hours');
		const minutesEl = document.getElementById('cd-minutes');
		const secondsEl = document.getElementById('cd-seconds');
		const gridEl = document.getElementById('countdown-grid');
		const titleEl = document.getElementById('countdown-title');

		if (!daysEl || !hoursEl || !minutesEl || !secondsEl) return;

		function updateTimer() {
			const now = Date.now();
			const diff = targetTime - now;

			if (diff <= 0) {
				if (titleEl) titleEl.textContent = EVENT_ENDED_TEXT;
				if (gridEl) gridEl.style.display = 'none';
				return;
			}

			const days = Math.floor(diff / (1000 * 60 * 60 * 24));
			const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
			const minutes = Math.floor((diff / 1000 / 60) % 60);
			const seconds = Math.floor((diff / 1000) % 60);

			daysEl!.textContent = String(days).padStart(2, '0');
			hoursEl!.textContent = String(hours).padStart(2, '0');
			minutesEl!.textContent = String(minutes).padStart(2, '0');
			secondsEl!.textContent = String(seconds).padStart(2, '0');
		}

		updateTimer();
		setInterval(updateTimer, 1000);
	}

	initCountdown();

	// ==========================================
	// 2. 最新活動メディア（RSS）読み込み設定
	// ==========================================
	const MEDIA_CONFIG = {
		blog: {
			apiUrl: '/api/rss',
			archiveUrl: 'https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/',
			archiveLabel: 'ブログ一覧を見る ↗',
			filterKeywords: []
		},
		note: {
			apiUrl: '/api/rss-note',
			archiveUrl: 'https://note.com/umi_sign_project',
			archiveLabel: 'note一覧を見る ↗',
			filterKeywords: []
		},
		youtube: {
			apiUrl: '/api/rss-youtube',
			archiveUrl: 'https://www.youtube.com/channel/UCNMQaHzpu6nnxoiiGwo_OrA',
			archiveLabel: 'YouTubeチャンネルへ ↗',
			filterKeywords: ['海のサインプロジェクト', '海のサイン']
		}
	};

	type MediaType = keyof typeof MEDIA_CONFIG;

	const cache: Partial<Record<MediaType, { title: string; link: string; date: string }[]>> = {};

	async function loadMedia(type: MediaType) {
		const container = document.getElementById('blog-list-container');
		const archiveLink = document.getElementById('external-archive-link') as HTMLAnchorElement | null;
		if (!container) return;

		const config = MEDIA_CONFIG[type];
		if (archiveLink) {
			archiveLink.href = config.archiveUrl;
			archiveLink.textContent = config.archiveLabel;
		}

		if (cache[type]) {
			renderPosts(cache[type]!, container);
			return;
		}

		container.innerHTML = '<p class="loading-text">最新情報を読み込み中...</p>';

		try {
			const res = await fetch(config.apiUrl);
			if (!res.ok) throw new Error(`HTTPエラー: ${res.status}`);
			const xmlText = await res.text();

			const parser = new DOMParser();
			const xmlDoc = parser.parseFromString(xmlText, "text/xml");

			if (xmlDoc.querySelector("parsererror")) {
				throw new Error('XMLの解析に失敗しました');
			}

			const entries = Array.from(xmlDoc.getElementsByTagName("entry"));
			const items = Array.from(xmlDoc.getElementsByTagName("item"));
			const isAtom = entries.length > 0;
			const rawItems = isAtom ? entries : items;

			const parsedItems = rawItems.map((item) => {
				const title = item.getElementsByTagName("title")[0]?.textContent?.trim() || '無題';
				
				let link = '#';
				if (isAtom) {
					const links = Array.from(item.getElementsByTagName("link"));
					const altLink = links.find(l => l.getAttribute("rel") === "alternate") || links[0];
					link = altLink?.getAttribute("href") || '#';
				} else {
					link = item.getElementsByTagName("link")[0]?.textContent?.trim() || '#';
				}

				const pubDateStr = (isAtom 
					? item.getElementsByTagName("published")[0]?.textContent 
					: item.getElementsByTagName("pubDate")[0]?.textContent) || '';
				
				const dateObj = new Date(pubDateStr);
				const formattedDate = !isNaN(dateObj.getTime())
					? `${dateObj.getFullYear()}.${String(dateObj.getMonth() + 1).padStart(2, '0')}.${String(dateObj.getDate()).padStart(2, '0')}`
					: '';

				const descNormal = item.getElementsByTagName("description")[0]?.textContent || '';
				const descMedia = item.getElementsByTagNameNS("*", "description")[0]?.textContent || '';
				const description = `${descNormal} ${descMedia}`;

				return { title, link, date: formattedDate, fullText: `${title} ${description}` };
			});

			const filteredItems = config.filterKeywords.length > 0
				? parsedItems.filter(post => 
					config.filterKeywords.some(keyword => post.fullText.includes(keyword))
				  )
				: parsedItems;

			const topPosts = filteredItems.slice(0, 3).map(({ title, link, date }) => ({ title, link, date }));
			cache[type] = topPosts;
			renderPosts(topPosts, container);

		} catch (error) {
			console.error(`[${type}] RSS読み込みエラー:`, error);
			container.innerHTML = '<p class="no-posts">情報の読み込みに失敗しました。</p>';
		}
	}

	function renderPosts(posts: { title: string; link: string; date: string }[], container: HTMLElement) {
		if (posts.length === 0) {
			container.innerHTML = '<p class="no-posts">該当する投稿はまだありません。</p>';
			return;
		}

		container.innerHTML = posts.map((post) => `
			<a href="${post.link}" target="_blank" rel="noopener noreferrer" class="blog-item">
				<div class="blog-date">${post.date}</div>
				<div class="blog-title">${post.title}</div>
				<div class="blog-arrow">↗</div>
			</a>
		`).join('');
	}

	function initTabs() {
		const buttons = document.querySelectorAll('.tab-btn');
		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const source = (btn as HTMLButtonElement).dataset.source as MediaType;
				if (!source) return;

				buttons.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');

				loadMedia(source);
			});
		});
	}

	initTabs();
	loadMedia('blog');
</script>

<style>
	/* ヒーローエリア */
	.hero {
		background: var(--ocean-gradient, radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%));
		color: #ffffff;
		padding: 3.5rem 1.25rem 5.25rem;
		text-align: center;
		position: relative;
	}
	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 880px;
		margin: 0 auto;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.25);
		padding: 0.4rem 1.15rem;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: 0.04em;
		margin-bottom: 1.5rem;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
	}
	.badge-dot {
		width: 8px;
		height: 8px;
		background-color: #38bdf8;
		border-radius: 50%;
		box-shadow: 0 0 8px #38bdf8;
	}

	.hero-text-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.hero-catch-title {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-size: clamp(2.1rem, 5.5vw, 3.3rem);
		font-weight: 900;
		line-height: 1.35;
		margin: 0;
		letter-spacing: 0.02em;
		color: #ffffff;
		text-shadow: 0 2px 8px rgba(8, 47, 73, 0.6);
	}

	.line-from { color: #f0f9ff; }
	.line-to { color: #ffffff; }

	.highlight-aqua {
		position: relative;
		display: inline-block;
		color: #ffffff;
		background: linear-gradient(transparent 62%, rgba(56, 189, 248, 0.5) 62%, rgba(14, 165, 233, 0.65) 100%);
		padding: 0 0.15em;
		border-radius: 2px;
	}

	.hero-caption {
		font-size: clamp(0.95rem, 2.2vw, 1.15rem);
		font-weight: 700;
		color: #e0f2fe;
		letter-spacing: 0.03em;
		margin-top: 0.25rem;
		text-shadow: 0 1px 4px rgba(8, 47, 73, 0.5);
	}

	/* カウントダウンUI */
	.countdown-box {
		margin-top: 1.75rem;
		background: rgba(8, 47, 73, 0.45);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid rgba(125, 211, 252, 0.35);
		border-radius: 16px;
		padding: 1rem 1.75rem 1.15rem;
		box-shadow: 0 8px 24px rgba(8, 47, 73, 0.35);
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 0.65rem;
	}
	.countdown-label {
		font-size: 0.85rem;
		font-weight: 700;
		color: #bae6fd;
		letter-spacing: 0.05em;
	}
	.countdown-grid {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.time-unit {
		display: flex;
		flex-direction: column;
		align-items: center;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 10px;
		min-width: 3.6rem;
		padding: 0.45rem 0.5rem;
	}
	.time-num {
		font-size: 1.65rem;
		font-weight: 900;
		line-height: 1.1;
		color: #ffffff;
		font-variant-numeric: tabular-nums;
		text-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
	}
	.time-text {
		font-size: 0.65rem;
		font-weight: 700;
		color: #7dd3fc;
		letter-spacing: 0.08em;
		margin-top: 0.2rem;
	}
	.time-sep {
		font-size: 1.35rem;
		font-weight: 800;
		color: rgba(255, 255, 255, 0.55);
		margin-bottom: 0.8rem;
	}

	.section {
		margin-top: -3rem;
		padding-bottom: 4rem;
		position: relative;
		z-index: 10;
	}
	.flex-container {
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.card {
		background: #ffffff;
		border-radius: 16px;
		padding: 2.5rem;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
		max-width: 1000px;
		margin: 0 auto;
		width: 100%;
		border: 1px solid var(--border, #e2e8f0);
	}

	.status-tag {
		display: inline-block;
		background: #f0f9ff;
		color: #0284c7;
		border: 1px solid #bae6fd;
		font-weight: 700;
		font-size: 0.75rem;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		margin-bottom: 1rem;
	}
	.card h2 {
		font-size: 1.5rem;
		font-weight: 800;
		margin-bottom: 1rem;
		color: #0f172a;
		line-height: 1.4;
		border-bottom: 2px solid #e0f2fe;
		padding-bottom: 0.5rem;
	}
	.desc {
		color: #475569;
		line-height: 1.8;
		font-size: 1rem;
		margin-bottom: 1.75rem;
	}

	.outline-box {
		background: #f8fafc;
		padding: 1.35rem 1.5rem;
		border-radius: 12px;
		border: 1px solid #e2e8f0;
		margin-bottom: 1.25rem;
	}
	.outline-box h3 {
		font-size: 1.1rem;
		color: #0284c7;
		margin-bottom: 0.5rem;
		font-weight: 700;
	}
	.box-desc {
		color: #334155;
		line-height: 1.75;
		font-size: 0.95rem;
	}

	.message-box {
		background: #f0f9ff;
		border-left: 4px solid #0284c7;
		padding: 1.25rem 1.5rem;
		border-radius: 8px;
		margin-bottom: 1.5rem;
	}
	.message-box h3 {
		font-size: 1.1rem;
		color: #0284c7;
		margin-bottom: 0.35rem;
		font-weight: 700;
	}
	.message-box p {
		color: #1e293b;
		line-height: 1.7;
		font-size: 0.95rem;
	}

	.info-box {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 12px;
		padding: 1rem 1.25rem;
		font-size: 0.925rem;
		color: #0284c7;
		font-weight: 700;
		text-align: center;
		line-height: 1.6;
	}

	/* 最終発表 YouTube動画カード */
	.featured-video-card {
		background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 32%);
		border: 2px solid #7dd3fc;
		box-shadow: 0 14px 32px -6px rgba(2, 132, 199, 0.14);
	}
	.video-badge-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.85rem;
	}
	.video-tag {
		display: inline-flex;
		align-items: center;
		background: #0284c7;
		color: #ffffff;
		font-weight: 800;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		padding: 0.32rem 0.85rem;
		border-radius: 9999px;
		box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
	}
	.video-sub {
		font-size: 0.85rem;
		font-weight: 700;
		color: #0369a1;
	}
	.video-desc {
		color: #475569;
		font-size: 0.95rem;
		line-height: 1.7;
		margin-bottom: 1.35rem;
	}
	.video-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 14px;
		overflow: hidden;
		background: #0f172a;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.2);
		border: 1px solid #bae6fd;
	}
	.video-wrapper iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.video-actions {
		margin-top: 1.25rem;
		display: flex;
		justify-content: center;
	}
	.youtube-watch-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		background: #dc2626;
		color: #ffffff;
		font-weight: 700;
		font-size: 0.9rem;
		padding: 0.7rem 1.5rem;
		border-radius: 9999px;
		text-decoration: none;
		box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
		transition: all 0.2s ease;
	}
