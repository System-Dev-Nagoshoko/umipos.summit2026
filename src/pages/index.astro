---
import Layout from '../layouts/Layout.astro';
---

<Layout title="海のサインプロジェクト | うみぽす甲子園2026 ファイナリスト">
	<main>
		<!-- ヒーローエリア: 文字の視認性を極限まで高めたオーシャングラデーション -->
		<section class="hero">
			<div class="container hero-inner">
				<div class="badge">
					<span class="badge-dot"></span>
					うみぽす甲子園2026 ファイナリスト
				</div>
				
				<div class="hero-text-wrap">
					<!-- 同サイズ・1セットの対比キャッチコピー -->
					<h1 class="hero-catch-title">
						<span class="line-from">「見る看板」から</span>
						<span class="line-to">「<span class="highlight-aqua">伝わる看板</span>」へ</span>
					</h1>
					<p class="hero-caption">
						名護の海を守る「海のサインプロジェクト」始動！
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container flex-container">
				
				<div class="card main-card">
					<div class="status-tag">TEAM PROFILE</div>
					<h2>はじめまして！「海のサインプロジェクト」です</h2>
					<p class="desc">
						私たちは、「見る看板ではなく、伝わる看板へ」をテーマに、誰もが安心して楽しめる名護の海を目指して活動している高校生チームです。
					</p>

					<div class="outline-box">
						<h3>🌊 なぜこの活動を始めたのか？</h3>
						<p class="box-desc">
							普段、何気なく見ている海岸の注意看板。実は「文字が小さくて読みづらい」「どこに危険があるのか伝わりにくい」といった課題があります。<br />
							そこで私たちは、実際に名護市の海岸を調査！子どもからお年寄りまで、国籍や年齢を問わず一目で危険が「伝わる」看板デザインを模索・制作しています。
						</p>
					</div>

					<div class="message-box">
						<h3>💡 私たちの想い</h3>
						<p>「名護市の美しい海を、みんながもっと安全に、笑顔で楽しめる場所にしたい」<br />そんな想いを込めて、メンバー一丸となって活動中です！</p>
					</div>

					<div class="info-box">
						<p>📢 今後も活動の様子や制作の裏側をブログでお届けしていきます。ぜひチェック＆応援よろしくお願いいたします！</p>
					</div>
				</div>

				<!-- 📝 記事投稿時に即更新される「明日の地図」公式ブログカード -->
				<div class="card blog-card">
					<div class="blog-header">
						<h2>📝 最新活動ブログ（明日の地図）</h2>
						<a 
							href="https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/" 
							target="_blank" 
							rel="noopener noreferrer" 
							class="all-posts-link"
						>
							ブログ一覧を見る ↗
						</a>
					</div>

					<div id="blog-list-container" class="blog-list">
						<p class="loading-text">最新記事を読み込み中...</p>
					</div>
				</div>

			</div>
		</section>
	</main>
</Layout>

<script>
	const RSS_URL = 'https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/feed/';

	async function fetchLatestPosts() {
		const container = document.getElementById('blog-list-container');
		if (!container) return;

		const cacheBuster = Date.now();
		const API_URL = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(RSS_URL)}&_t=${cacheBuster}`;

		try {
			const res = await fetch(API_URL);
			const data = await res.json();

			if (data.status === 'ok' && data.items && data.items.length > 0) {
				const postsHtml = data.items.slice(0, 3).map((item: any) => {
					const dateObj = new Date(item.pubDate);
					const formattedDate = !isNaN(dateObj.getTime())
						? `${dateObj.getFullYear()}.${String(dateObj.getMonth() + 1).padStart(2, '0')}.${String(dateObj.getDate()).padStart(2, '0')}`
						: '';

					return `
						<a href="${item.link}" target="_blank" rel="noopener noreferrer" class="blog-item">
							<div class="blog-date">${formattedDate}</div>
							<div class="blog-title">${item.title}</div>
							<div class="blog-arrow">↗</div>
						</a>
					`;
				}).join('');

				container.innerHTML = postsHtml;
			} else {
				container.innerHTML = '<p class="no-posts">最新記事はありません。</p>';
			}
		} catch (error) {
			console.error('RSS読み込みエラー:', error);
			container.innerHTML = '<p class="no-posts">記事の読み込みに失敗しました。</p>';
		}
	}

	fetchLatestPosts();
</script>

<style>
	/* ヒーローエリア: 白文字の視認性が最も際立つディープオーシャングラデーション */
	.hero {
		background: radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%);
		color: #ffffff;
		padding: 5rem 1.25rem 6.5rem;
		text-align: center;
		position: relative;
	}
	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 880px;
		margin: 0 auto;
	}

	/* バッジ */
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.25);
		padding: 0.4rem 1.15rem;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: 0.04em;
		margin-bottom: 2rem;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
	}
	.badge-dot {
		width: 8px;
		height: 8px;
		background-color: #38bdf8;
		border-radius: 50%;
		box-shadow: 0 0 8px #38bdf8;
	}

	/* キャッチコピー文字エリア */
	.hero-text-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
	}

	/* 1セットの見出し（上下ともに完全に同じフォントサイズ） */
	.hero-catch-title {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-size: clamp(2.1rem, 5.5vw, 3.3rem);
		font-weight: 900;
		line-height: 1.35;
		margin: 0;
		letter-spacing: 0.02em;
		color: #ffffff;
		/* 視認性を補強する落ち着いたドロップシャドウ */
		text-shadow: 0 2px 8px rgba(8, 47, 73, 0.6);
	}

	/* 1行目: まとまりを感じるソフトホワイト */
	.line-from {
		color: #f0f9ff;
	}

	/* 2行目: クリアな純白 */
	.line-to {
		color: #ffffff;
	}

	/* 「伝わる看板」のアクセント: 文字の可読性を損なわない爽やかな下線グラデーション */
	.highlight-aqua {
		position: relative;
		display: inline-block;
		color: #ffffff;
		background: linear-gradient(transparent 62%, rgba(56, 189, 248, 0.5) 62%, rgba(14, 165, 233, 0.65) 100%);
		padding: 0 0.15em;
		border-radius: 2px;
	}

	/* サブタイトル */
	.hero-caption {
		font-size: clamp(1rem, 2.4vw, 1.2rem);
		font-weight: 700;
		color: #e0f2fe;
		letter-spacing: 0.03em;
		margin-top: 0.35rem;
		text-shadow: 0 1px 4px rgba(8, 47, 73, 0.5);
	}

	/* メインレイアウト */
	.section {
		margin-top: -3rem;
		padding-bottom: 4rem;
		position: relative;
		z-index: 10;
	}
	.flex-container {
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.card {
		background: #ffffff;
		border-radius: 16px;
		padding: 2.5rem;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
		max-width: 1000px;
		margin: 0 auto;
		width: 100%;
		border: 1px solid #e2e8f0;
	}

	.status-tag {
		display: inline-block;
		background: #f0f9ff;
		color: #0284c7;
		border: 1px solid #bae6fd;
		font-weight: 700;
		font-size: 0.75rem;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		margin-bottom: 1rem;
	}
	.card h2 {
		font-size: 1.45rem;
		font-weight: 700;
		margin-bottom: 1rem;
		color: #0f172a;
		line-height: 1.45;
		border-bottom: 2px solid #e0f2fe;
		padding-bottom: 0.5rem;
	}
	.desc {
		color: #475569;
		line-height: 1.8;
		font-size: 0.975rem;
		margin-bottom: 1.75rem;
	}

	.outline-box {
		background: #f8fafc;
		padding: 1.35rem 1.5rem;
		border-radius: 12px;
		border: 1px solid #e2e8f0;
		margin-bottom: 1.25rem;
	}
	.outline-box h3 {
		font-size: 1.05rem;
		color: #0284c7;
		margin-bottom: 0.5rem;
		font-weight: 700;
	}
	.box-desc {
		color: #334155;
		line-height: 1.75;
		font-size: 0.95rem;
	}

	.message-box {
		background: #f0f9ff;
		border-left: 4px solid #0284c7;
		padding: 1.25rem 1.5rem;
		border-radius: 8px;
		margin-bottom: 1.5rem;
	}
	.message-box h3 {
		font-size: 1.05rem;
		color: #0284c7;
		margin-bottom: 0.35rem;
		font-weight: 700;
	}
	.message-box p {
		color: #1e293b;
		line-height: 1.7;
		font-size: 0.95rem;
	}

	.info-box {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 12px;
		padding: 1rem 1.25rem;
		font-size: 0.925rem;
		color: #0284c7;
		font-weight: 700;
		text-align: center;
		line-height: 1.6;
	}

	.blog-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.blog-header h2 {
		margin-bottom: 0;
		border-bottom: none;
		padding-bottom: 0;
	}
	.all-posts-link {
		font-size: 0.85rem;
		color: #0284c7;
		font-weight: 700;
		text-decoration: none;
	}
	.all-posts-link:hover {
		text-decoration: underline;
	}

	.blog-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	:global(.blog-item) {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.95rem 1.25rem;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	:global(.blog-item:hover) {
		background: #ffffff;
		border-color: #38bdf8;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
	}
	:global(.blog-date) {
		font-size: 0.8rem;
		font-weight: 700;
		color: #0284c7;
		background: #e0f2fe;
		padding: 0.25rem 0.6rem;
		border-radius: 6px;
		flex-shrink: 0;
	}
	:global(.blog-title) {
		font-size: 0.95rem;
		font-weight: 700;
		color: #1e293b;
		flex: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	:global(.blog-arrow) {
		font-weight: bold;
		color: #0284c7;
		flex-shrink: 0;
	}

	.loading-text,
	.no-posts {
		color: #64748b;
		font-size: 0.9rem;
		text-align: center;
		padding: 1.5rem 0;
	}

	@media (max-width: 640px) {
		.hero {
			padding: 3.75rem 1rem 5.5rem;
		}
		.hero-catch-title {
			font-size: 1.85rem;
		}
		.card {
			padding: 1.6rem 1.15rem;
		}
		:global(.blog-item) {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.45rem;
		}
		:global(.blog-title) {
			white-space: normal;
		}
		:global(.blog-arrow) {
			display: none;
		}
	}
</style>
