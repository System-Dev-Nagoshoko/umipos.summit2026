---
import Layout from '../layouts/Layout.astro';
---

<Layout title="海のサインプロジェクト | うみぽす甲子園2026 ファイナリスト">
	<main>
		<!-- ヒーローエリア: 文字の視認性を極限まで高めたオーシャングラデーション -->
		<section class="hero">
			<div class="container hero-inner">
				<div class="badge">
					<span class="badge-dot"></span>
					うみぽす甲子園2026 ファイナリスト
				</div>
				
				<div class="hero-text-wrap">
					<!-- 同サイズ・1セットの対比キャッチコピー -->
					<h1 class="hero-catch-title">
						<span class="line-from">「見る看板」から</span>
						<span class="line-to">「<span class="highlight-aqua">伝わる看板</span>」へ</span>
					</h1>
					<p class="hero-caption">
						名護の海を守る「海のサインプロジェクト」始動！
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container flex-container">
				
				<div class="card main-card">
					<div class="status-tag">TEAM PROFILE</div>
					<h2>はじめまして！「海のサインプロジェクト」です</h2>
					<p class="desc">
						私たちは、「見る看板ではなく、伝わる看板へ」をテーマに、誰もが安心して楽しめる名護の海を目指して活動している高校生チームです。
					</p>

					<div class="outline-box">
						<h3>🌊 なぜこの活動を始めたのか？</h3>
						<p class="box-desc">
							普段、何気なく見ている海岸の注意看板。実は「文字が小さくて読みづらい」「どこに危険があるのか伝わりにくい」といった課題があります。<br />
							そこで私たちは、実際に名護市の海岸を調査！子どもからお年寄りまで、国籍や年齢を問わず一目で危険が「伝わる」看板デザインを模索・制作しています。
						</p>
					</div>

					<div class="message-box">
						<h3>💡 私たちの想い</h3>
						<p>「名護市の美しい海を、みんながもっと安全に、笑顔で楽しめる場所にしたい」<br />そんな想いを込めて、メンバー一丸となって活動中です！</p>
					</div>

					<div class="info-box">
						<p>📢 今後も活動の様子や制作の裏側をブログでお届けしていきます。ぜひチェック＆応援よろしくお願いいたします！</p>
					</div>
				</div>

				<!-- 📝 記事投稿時に即更新される「明日の地図」公式ブログカード -->
				<div class="card blog-card">
					<div class="blog-header">
						<h2>📝 最新活動ブログ（明日の地図）</h2>
						<a 
							href="https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/" 
							target="_blank" 
							rel="noopener noreferrer" 
							class="all-posts-link"
						>
							ブログ一覧を見る ↗
						</a>
					</div>

					<div id="blog-list-container" class="blog-list">
						<p class="loading-text">最新記事を読み込み中...</p>
					</div>
				</div>

			</div>
		</section>
	</main>
</Layout>

<script>
	const RSS_URL = 'https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/feed/';

	async function fetchLatestPosts() {
		const container = document.getElementById('blog-list-container');
		if (!container) return;

		// CORSエラー回避のため allorigins プロキシを使用
		const PROXY_URL = `https://api.allorigins.win/get?url=${encodeURIComponent(RSS_URL)}`;

		try {
			const res = await fetch(PROXY_URL);
			if (!res.ok) throw new Error('ネットワーク応答エラー');
			const data = await res.json();

			if (data && data.contents) {
				const parser = new DOMParser();
				const xmlDoc = parser.parseFromString(data.contents, "text/xml");
				const items = Array.from(xmlDoc.querySelectorAll("item"));

				if (items.length > 0) {
					const postsHtml = items.slice(0, 3).map((item) => {
						const title = item.querySelector("title")?.textContent || '無題';
						const link = item.querySelector("link")?.textContent || '#';
						const pubDate = item.querySelector("pubDate")?.textContent || '';

						const dateObj = new Date(pubDate);
						const formattedDate = !isNaN(dateObj.getTime())
							? `${dateObj.getFullYear()}.${String(dateObj.getMonth() + 1).padStart(2, '0')}.${String(dateObj.getDate()).padStart(2, '0')}`
							: '';

						return `
							<a href="${link}" target="_blank" rel="noopener noreferrer" class="blog-item">
								<div class="blog-date">${formattedDate}</div>
								<div class="blog-title">${title}</div>
								<div class="blog-arrow">↗</div>
							</a>
						`;
					}).join('');

					container.innerHTML = postsHtml;
				} else {
					container.innerHTML = '<p class="no-posts">最新記事はありません。</p>';
				}
			} else {
				container.innerHTML = '<p class="no-posts">最新記事はありません。</p>';
			}
		} catch (error) {
			console.error('RSS読み込みエラー:', error);
			container.innerHTML = '<p class="no-posts">記事の読み込みに失敗しました。</p>';
		}
	}

	fetchLatestPosts();
</script>

<style>
	/* ヒーローエリア: 白文字の視認性が最も際立つディープオーシャングラデーション */
	.hero {
		background: var(--ocean-gradient, radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%));
		color: #ffffff;
		padding: 5rem 1.25rem 6.5rem;
		text-align: center;
		position: relative;
	}
	.hero-inner {
		display: flex;
		flex-direction: column
