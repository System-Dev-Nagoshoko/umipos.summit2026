	}
	.badge-dot {
		width: 8px;
		height: 8px;
		background-color: #38bdf8;
		border-radius: 50%;
		box-shadow: 0 0 10px #38bdf8;
	}

	.hero-text-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.hero-catch-title {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-size: clamp(2.1rem, 5.5vw, 3.3rem);
		font-weight: 900;
		line-height: 1.35;
		margin: 0;
		letter-spacing: 0.02em;
		color: #ffffff;
		text-shadow: 0 2px 8px rgba(8, 47, 73, 0.6);
	}

