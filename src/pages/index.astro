---
import Layout from '../layouts/Layout.astro';
---

<Layout title="海のサインプロジェクト | うみぽす甲子園2026 ファイナリスト">
	<main>
		<section class="hero">
			<div class="container hero-inner">
				<div class="badge">
					<span class="badge-dot"></span>
					うみぽす甲子園2026 ファイナリスト
				</div>
				
				<div class="hero-text-wrap">
					<h1 class="hero-catch-title">
						<span class="line-from">「見る看板」から</span>
						<span class="line-to">「<span class="highlight-aqua">伝わる看板</span>」へ</span>
					</h1>
					<p class="hero-caption">
						名護の海を守る「海のサインプロジェクト」始動！
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container flex-container">
				
				<div class="card main-card">
					<div class="status-tag">TEAM PROFILE</div>
					<h2>はじめまして！「海のサインプロジェクト」です</h2>
					<p class="desc">
						私たちは、「見る看板ではなく、伝わる看板へ」をテーマに、誰もが安心して楽しめる名護の海を目指して活動している高校生チームです。
					</p>

					<div class="outline-box">
						<h3>🌊 なぜこの活動を始めたのか？</h3>
						<p class="box-desc">
							普段、何気なく見ている海岸の注意看板。実は「文字が小さくて読みづらい」「どこに危険があるのか伝わりにくい」といった課題があります。<br />
							そこで私たちは、実際に名護市の海岸を調査！子どもからお年寄りまで、国籍や年齢を問わず一目で危険が「伝わる」看板デザインを模索・制作しています。
						</p>
					</div>

					<div class="message-box">
						<h3>💡 私たちの想い</h3>
						<p>「名護市の美しい海を、みんながもっと安全に、笑顔で楽しめる場所にしたい」<br />そんな想いを込めて、メンバー一丸となって活動中です！</p>
					</div>

					<div class="info-box">
						<p>📢 今後も活動の様子や制作の裏側をブログやSNSでお届けしていきます。ぜひチェック＆応援よろしくお願いいたします！</p>
					</div>
				</div>

				<div class="card blog-card">
					<div class="blog-header">
						<h2>📢 最新活動メディア</h2>
						
						<div class="tab-controls" role="tablist">
							<button type="button" class="tab-btn active" data-source="blog">明日の地図</button>
							<button type="button" class="tab-btn" data-source="note">note</button>
							<button type="button" class="tab-btn" data-source="youtube">YouTube</button>
						</div>

						<a 
							id="external-archive-link"
							href="https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/" 
							target="_blank" 
							rel="noopener noreferrer" 
							class="all-posts-link"
						>
							ブログ一覧を見る ↗
						</a>
					</div>

					<div id="blog-list-container" class="blog-list">
						<p class="loading-text">最新情報を読み込み中...</p>
					</div>
				</div>

			</div>
		</section>
	</main>
</Layout>

<script>
	// メディアごとの設定（統合した /api/rss に接続）
	const MEDIA_CONFIG = {
		blog: {
			apiUrl: '/api/rss?type=blog',
			archiveUrl: 'https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/',
			archiveLabel: 'ブログ一覧を見る ↗',
			filterKeywords: [] // フィルタなし
		},
		note: {
			apiUrl: '/api/rss?type=note',
			archiveUrl: 'https://note.com/umi_sign_project',
			archiveLabel: 'note一覧を見る ↗',
			filterKeywords: [] // フィルタなし
		},
		youtube: {
			apiUrl: '/api/rss?type=youtube',
			archiveUrl: 'https://www.youtube.com/channel/UCNMQaHzpu6nnxoiiGwo_OrA',
			archiveLabel: 'YouTubeチャンネルへ ↗',
			// タイトルまたは説明文にこのキーワードが含まれる動画のみ抽出
			filterKeywords: ['海のサインプロジェクト', '海のサイン']
		}
	};

	type MediaType = keyof typeof MEDIA_CONFIG;

	// キャッシュ用（タブ切り替えのたびに再通信しないようにする）
	const cache: Partial<Record<MediaType, { title: string; link: string; date: string }[]>> = {};

	async function loadMedia(type: MediaType) {
		const container = document.getElementById('blog-list-container');
		const archiveLink = document.getElementById('external-archive-link') as HTMLAnchorElement | null;
		if (!container) return;

		const config = MEDIA_CONFIG[type];
		if (archiveLink) {
			archiveLink.href = config.archiveUrl;
			archiveLink.textContent = config.archiveLabel;
		}

		// キャッシュがあれば即座に描画
		if (cache[type]) {
			renderPosts(cache[type]!, container);
			return;
		}

		container.innerHTML = '<p class="loading-text">最新情報を読み込み中...</p>';

		try {
			const res = await fetch(config.apiUrl);
			if (!res.ok) throw new Error('ネットワーク応答エラー');
			const xmlText = await res.text();

			const parser = new DOMParser();
			const xmlDoc = parser.parseFromString(xmlText, "text/xml");

			// RSS 2.0 (<item>) と Atom/YouTube (<entry>) の両方に対応
			const isAtom = xmlDoc.querySelectorAll("entry").length > 0;
			const rawItems = Array.from(xmlDoc.querySelectorAll(isAtom ? "entry" : "item"));

			const parsedItems = rawItems.map((item) => {
				const title = item.querySelector("title")?.textContent || '無題';
				
				// リンクの取得（Atom形式は <link href="..."> 属性）
				let link = '#';
				if (isAtom) {
					link = item.querySelector("link")?.getAttribute("href") || '#';
				} else {
					link = item.querySelector("link")?.textContent || '#';
				}

				// 日付の取得（YouTubeは <published>）
				const pubDateStr = item.querySelector(isAtom ? "published" : "pubDate")?.textContent || '';
				const dateObj = new Date(pubDateStr);
				const formattedDate = !isNaN(dateObj.getTime())
					? `${dateObj.getFullYear()}.${String(dateObj.getMonth() + 1).padStart(2, '0')}.${String(dateObj.getDate()).padStart(2, '0')}`
					: '';

				// 検索フィルタ用のテキスト（タイトル＋概要欄）
				const description = item.querySelector("description")?.textContent || 
				                    item.getElementsByTagName("media:description")[0]?.textContent || '';

				return { title, link, date: formattedDate, fullText: `${title} ${description}` };
			});

			// キーワードフィルタリング（YouTube用）
			const filteredItems = config.filterKeywords.length > 0
				? parsedItems.filter(post => 
					config.filterKeywords.some(keyword => post.fullText.includes(keyword))
				  )
				: parsedItems;

			const topPosts = filteredItems.slice(0, 3).map(({ title, link, date }) => ({ title, link, date }));
			cache[type] = topPosts;
			renderPosts(topPosts, container);

		} catch (error) {
			console.error('RSS読み込みエラー:', error);
			container.innerHTML = '<p class="no-posts">情報の読み込みに失敗しました。</p>';
		}
	}

	function renderPosts(posts: { title: string; link: string; date: string }[], container: HTMLElement) {
		if (posts.length === 0) {
			container.innerHTML = '<p class="no-posts">該当する投稿はまだありません。</p>';
			return;
		}

		container.innerHTML = posts.map((post) => `
			<a href="${post.link}" target="_blank" rel="noopener noreferrer" class="blog-item">
				<div class="blog-date">${post.date}</div>
				<div class="blog-title">${post.title}</div>
				<div class="blog-arrow">↗</div>
			</a>
		`).join('');
	}

	// タブボタンのイベント登録
	document.querySelectorAll('.tab-btn').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLButtonElement;
			const source = target.dataset.source as MediaType;
			if (!source) return;

			document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
			target.classList.add('active');

			loadMedia(source);
		});
	});

	// 初期表示（明日の地図）
	loadMedia('blog');
</script>

<style>
	/* ヒーローエリア */
	.hero {
		background: var(--ocean-gradient, radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%));
		color: #ffffff;
		padding: 3.5rem 1.25rem 5rem;
		text-align: center;
		position: relative;
	}
	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 880px;
		margin: 0 auto;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.25);
		padding: 0.4rem 1.15rem;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: 0.04em;
		margin-bottom: 1.5rem;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
	}
	.badge-dot {
		width: 8px;
		height: 8px;
		background-color: #38bdf8;
		border-radius: 50%;
		box-shadow: 0 0 8px #38bdf8;
	}

	.hero-text-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.hero-catch-title {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-size: clamp(2.1rem, 5.5vw, 3.3rem);
		font-weight: 900;
		line-height: 1.35;
		margin: 0;
		letter-spacing: 0.02em;
		color: #ffffff;
		text-shadow: 0 2px 8px rgba(8, 47, 73, 0.6);
	}

	.line-from { color: #f0f9ff; }
	.line-to { color: #ffffff; }

	.highlight-aqua {
		position: relative;
		display: inline-block;
		color: #ffffff;
		background: linear-gradient(transparent 62%, rgba(56, 189, 248, 0.5) 62%, rgba(14, 165, 233, 0.65) 100%);
		padding: 0 0.15em;
		border-radius: 2px;
	}

	.hero-caption {
		font-size: clamp(0.95rem, 2.2vw, 1.15rem);
		font-weight: 700;
		color: #e0f2fe;
		letter-spacing: 0.03em;
		margin-top: 0.25rem;
		text-shadow: 0 1px 4px rgba(8, 47, 73, 0.5);
	}

	.section {
		margin-top: -3rem;
		padding-bottom: 4rem;
		position: relative;
		z-index: 10;
	}
	.flex-container {
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.card {
		background: #ffffff;
		border-radius: 16px;
		padding: 2.5rem;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
		max-width: 1000px;
		margin: 0 auto;
		width: 100%;
		border: 1px solid var(--border, #e2e8f0);
	}

	.status-tag {
		display: inline-block;
		background: #f0f9ff;
		color: #0284c7;
		border: 1px solid #bae6fd;
		font-weight: 700;
		font-size: 0.75rem;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		margin-bottom: 1rem;
	}
	.card h2 {
		font-size: 1.5rem;
		font-weight: 800;
		margin-bottom: 1rem;
		color: #0f172a;
		line-height: 1.4;
		border-bottom: 2px solid #e0f2fe;
		padding-bottom: 0.5rem;
	}
	.desc {
		color: #475569;
		line-height: 1.8;
		font-size: 1rem;
		margin-bottom: 1.75rem;
	}

	.outline-box {
		background: #f8fafc;
		padding: 1.35rem 1.5rem;
		border-radius: 12px;
		border: 1px solid #e2e8f0;
		margin-bottom: 1.25rem;
	}
	.outline-box h3 {
		font-size: 1.1rem;
		color: #0284c7;
		margin-bottom: 0.5rem;
		font-weight: 700;
	}
	.box-desc {
		color: #334155;
		line-height: 1.75;
		font-size: 0.95rem;
	}

	.message-box {
		background: #f0f9ff;
		border-left: 4px solid #0284c7;
		padding: 1.25rem 1.5rem;
		border-radius: 8px;
		margin-bottom: 1.5rem;
	}
	.message-box h3 {
		font-size: 1.1rem;
		color: #0284c7;
		margin-bottom: 0.35rem;
		font-weight: 700;
	}
	.message-box p {
		color: #1e293b;
		line-height: 1.7;
		font-size: 0.95rem;
	}

	.info-box {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 12px;
		padding: 1rem 1.25rem;
		font-size: 0.925rem;
		color: #0284c7;
		font-weight: 700;
		text-align: center;
		line-height: 1.6;
	}

	/* ヘッダー＆タブ切り替えUI */
	.blog-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
		flex-wrap: wrap;
		gap: 0.85rem;
	}
	.blog-header h2 {
		margin-bottom: 0;
		border-bottom: none;
		padding-bottom: 0;
	}

	.tab-controls {
		display: inline-flex;
		background: #f1f5f9;
		padding: 0.25rem;
		border-radius: 10px;
		border: 1px solid #e2e8f0;
		gap: 0.25rem;
	}
	.tab-btn {
		background: transparent;
		border: none;
		padding: 0.45rem 0.95rem;
		border-radius: 7px;
		font-size: 0.85rem;
		font-weight: 700;
		color: #64748b;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.tab-btn:hover {
		color: #0f172a;
	}
	.tab-btn.active {
		background: #ffffff;
		color: #0284c7;
		box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
	}

	.all-posts-link {
		font-size: 0.85rem;
		color: #0284c7;
		font-weight: 700;
		text-decoration: none;
	}
	.all-posts-link:hover {
		text-decoration: underline;
	}

	.blog-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	:global(.blog-item) {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.95rem 1.25rem;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	:global(.blog-item:hover) {
		background: #ffffff;
		border-color: #38bdf8;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
	}
	:global(.blog-date) {
		font-size: 0.8rem;
		font-weight: 700;
		color: #0284c7;
		background: #e0f2fe;
		padding: 0.25rem 0.6rem;
		border-radius: 6px;
		flex-shrink: 0;
	}
	:global(.blog-title) {
		font-size: 0.95rem;
		font-weight: 700;
		color: #1e293b;
		flex: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	:global(.blog-arrow) {
		font-weight: bold;
		color: #0284c7;
		flex-shrink: 0;
	}

	.loading-text,
	.no-posts {
		color: #64748b;
		font-size: 0.9rem;
		text-align: center;
		padding: 1.5rem 0;
	}

	@media (max-width: 640px) {
		.hero {
			padding: 2.75rem 1rem 4.5rem;
		}
		.hero-catch-title {
			font-size: 1.95rem;
			line-height: 1.3;
		}
		.card {
			padding: 1.4rem 1rem;
		}
		.card h2 {
			font-size: 1.25rem;
		}
		.tab-controls {
			width: 100%;
			justify-content: space-between;
		}
		.tab-btn {
			flex: 1;
			text-align: center;
			padding: 0.45rem 0.5rem;
			font-size: 0.8rem;
		}
		:global(.blog-item) {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.45rem;
		}
		:global(.blog-title) {
			white-space: normal;
		}
		:global(.blog-arrow) {
			display: none;
		}
	}
</style>
