		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 14px;
		overflow: hidden;
		background: #0f172a;
		box-shadow: 0 12px 28px -5px rgba(15, 23, 42, 0.25);
		border: 1px solid #bae6fd;
