---
import Layout from '../layouts/Layout.astro';
---

<Layout title="海のサインプロジェクト | うみぽす甲子園2026 ファイナリスト">
	<main>
		<!-- ヒーローエリア -->
		<section class="hero">
			<div class="container hero-inner">
				<div class="badge">
					<span class="badge-dot"></span>
					うみぽす甲子園2026 ファイナリスト
				</div>
				
				<div class="hero-text-wrap">
					<p class="hero-subline">
						「見る看板」から
					</p>
					<h1 class="hero-mainline">
						「<span class="contrast-blue">伝わる看板</span>」へ
					</h1>
					<p class="hero-caption">
						名護の海を守る「海のサインプロジェクト」始動！
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container flex-container">
				
				<div class="card main-card">
					<div class="status-tag">TEAM PROFILE</div>
					<h2>はじめまして！「海のサインプロジェクト」です</h2>
					<p class="desc">
						私たちは、「見る看板ではなく、伝わる看板へ」をテーマに、誰もが安心して楽しめる名護の海を目指して活動している高校生チームです。
					</p>

					<div class="outline-box">
						<h3>🌊 なぜこの活動を始めたのか？</h3>
						<p class="box-desc">
							普段、何気なく見ている海岸の注意看板。実は「文字が小さくて読みづらい」「どこに危険があるのか伝わりにくい」といった課題があります。<br />
							そこで私たちは、実際に名護市の海岸を調査！子どもからお年寄りまで、国籍や年齢を問わず一目で危険が「伝わる」看板デザインを模索・制作しています。
						</p>
					</div>

					<div class="message-box">
						<h3>💡 私たちの想い</h3>
						<p>「名護市の美しい海を、みんながもっと安全に、笑顔で楽しめる場所にしたい」<br />そんな想いを込めて、メンバー一丸となって活動中です！</p>
					</div>

					<div class="info-box">
						<p>📢 今後も活動の様子や制作の裏側をブログでお届けしていきます。ぜひチェック＆応援よろしくお願いいたします！</p>
					</div>
				</div>

				<!-- 📝 記事投稿時に即更新される「明日の地図」公式ブログカード -->
				<div class="card blog-card">
					<div class="blog-header">
						<h2>📝 最新活動ブログ（明日の地図）</h2>
						<a 
							href="https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/" 
							target="_blank" 
							rel="noopener noreferrer" 
							class="all-posts-link"
						>
							ブログ一覧を見る ↗
						</a>
					</div>

					<div id="blog-list-container" class="blog-list">
						<p class="loading-text">最新記事を読み込み中...</p>
					</div>
				</div>

			</div>
		</section>
	</main>
</Layout>

<script>
	const RSS_URL = 'https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/feed/';

	async function fetchLatestPosts() {
		const container = document.getElementById('blog-list-container');
		if (!container) return;

		const cacheBuster = Date.now();
		const API_URL = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(RSS_URL)}&_t=${cacheBuster}`;

		try {
			const res = await fetch(API_URL);
			const data = await res.json();

			if (data.status === 'ok' && data.items && data.items.length > 0) {
				const postsHtml = data.items.slice(0, 3).map((item: any) => {
					const dateObj = new Date(item.pubDate);
					const formattedDate = !isNaN(dateObj.getTime())
						? `${dateObj.getFullYear()}.${String(dateObj.getMonth() + 1).padStart(2, '0')}.${String(dateObj.getDate()).padStart(2, '0')}`
						: '';

					return `
						<a href="${item.link}" target="_blank" rel="noopener noreferrer" class="blog-item">
							<div class="blog-date">${formattedDate}</div>
							<div class="blog-title">${item.title}</div>
							<div class="blog-arrow">↗</div>
						</a>
					`;
				}).join('');

				container.innerHTML = postsHtml;
			} else {
				container.innerHTML = '<p class="no-posts">最新記事はありません。</p>';
			}
		} catch (error) {
			console.error('RSS読み込みエラー:', error);
			container.innerHTML = '<p class="no-posts">記事の読み込みに失敗しました。</p>';
		}
	}

	fetchLatestPosts();
</script>

<style>
	/* ヒーローエリア */
	.hero {
		background: radial-gradient(circle at 50% 15%, #0f2438 0%, #09131d 75%, #04080e 100%);
		padding: 5rem 1.25rem 6.5rem;
		text-align: center;
		position: relative;
	}
	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 860px;
		margin: 0 auto;
	}

	/* バッジ */
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.15);
		padding: 0.35rem 1rem;
		border-radius: 9999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: #cbd5e1;
		letter-spacing: 0.04em;
		margin-bottom: 2rem;
	}
	.badge-dot {
		width: 7px;
		height: 7px;
		background-color: #38bdf8;
		border-radius: 50%;
	}

	/* キャッチコピー文字エリア */
	.hero-text-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
	}

	/* 1行目: オフホワイトで素直に読ませる */
	.hero-subline {
		font-size: clamp(1.2rem, 3vw, 1.55rem);
		font-weight: 600;
		color: #e2e8f0;
		letter-spacing: 0.04em;
		margin: 0;
	}

	/* 2行目 */
	.hero-mainline {
		font-size: clamp(2.3rem, 6vw, 3.6rem);
		font-weight: 900;
		color: #ffffff;
		line-height: 1.25;
		margin: 0.25rem 0 0.75rem;
		letter-spacing: 0.02em;
	}

	/* ▼ 青文字 ＋ 背後に反対色（アンバー・オレンジ）のバックライト演出 ▼ */
	.contrast-blue {
		position: relative;
		display: inline-block;
		color: #38bdf8; /* 清涼感のあるオーシャンブルー */
		font-weight: 900;
		/* 青の反対色（オレンジ・アンバー）の柔らかな多重シャドウで文字輪郭を際立たせる */
		text-shadow: 
			0 0 10px rgba(249, 115, 22, 0.7),
			0 0 24px rgba(245, 158, 11, 0.5),
			0 0 45px rgba(234, 88, 12, 0.35);
		padding: 0 0.15em;
	}

	/* 文字背後にふんわり敷く反対色のソフトグロー光体 */
	.contrast-blue::before {
		content: '';
		position: absolute;
		inset: -8% -15%;
		background: radial-gradient(
			ellipse at center,
			rgba(245, 158, 11, 0.32) 0%,
			rgba(234, 88, 12, 0.15) 50%,
			transparent 75%
		);
		border-radius: 9999px;
		filter: blur(12px);
		z-index: -1;
		pointer-events: none;
	}

	/* 3行目 */
	.hero-caption {
		font-size: clamp(0.95rem, 2.4vw, 1.15rem);
		font-weight: 600;
		color: #cbd5e1;
		letter-spacing: 0.03em;
		margin: 0;
	}

	/* メインレイアウト */
	.section {
		margin-top: -2.5rem;
		padding-bottom: 4rem;
		position: relative;
		z-index: 10;
	}
	.flex-container {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.card {
		background: #ffffff;
		border-radius: 14px;
		padding: 2.25rem;
		box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
		max-width: 960px;
		margin: 0 auto;
		width: 100%;
		border: 1px solid #e2e8f0;
	}

	.status-tag {
		display: inline-block;
		background: #f0f9ff;
		color: #0369a1;
		border: 1px solid #bae6fd;
		font-weight: 700;
		font-size: 0.75rem;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		margin-bottom: 1rem;
	}
	.card h2 {
		font-size: 1.35rem;
		font-weight: 700;
		margin-bottom: 1rem;
		color: #0f172a;
		line-height: 1.45;
		border-bottom: 2px solid #e0f2fe;
		padding-bottom: 0.5rem;
	}
	.desc {
		color: #334155;
		line-height: 1.8;
		font-size: 0.975rem;
		margin-bottom: 1.75rem;
	}

	.outline-box {
		background: #f8fafc;
		padding: 1.25rem 1.5rem;
		border-radius: 10px;
		border: 1px solid #e2e8f0;
		margin-bottom: 1.25rem;
	}
	.outline-box h3 {
		font-size: 1.05rem;
		color: #0369a1;
		margin-bottom: 0.5rem;
		font-weight: 700;
	}
	.box-desc {
		color: #334155;
		line-height: 1.75;
		font-size: 0.925rem;
	}

	.message-box {
		background: #f0f9ff;
		border-left: 4px solid #0284c7;
		padding: 1.25rem 1.5rem;
		border-radius: 6px;
		margin-bottom: 1.5rem;
	}
	.message-box h3 {
		font-size: 1rem;
		color: #0369a1;
		margin-bottom: 0.35rem;
		font-weight: 700;
	}
	.message-box p {
		color: #1e293b;
		line-height: 1.7;
		font-size: 0.925rem;
	}

	.info-box {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
		padding: 1rem 1.25rem;
		font-size: 0.9rem;
		color: #0369a1;
		font-weight: 600;
		text-align: center;
		line-height: 1.6;
	}

	.blog-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.blog-header h2 {
		margin-bottom: 0;
		border-bottom: none;
		padding-bottom: 0;
	}
	.all-posts-link {
		font-size: 0.85rem;
		color: #0284c7;
		font-weight: 600;
		text-decoration: none;
	}
	.all-posts-link:hover {
		text-decoration: underline;
	}

	.blog-list {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	:global(.blog-item) {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.85rem 1.15rem;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		text-decoration: none;
		transition: border-color 0.2s, background-color 0.2s;
	}
	:global(.blog-item:hover) {
		background: #ffffff;
		border-color: #38bdf8;
	}
	:global(.blog-date) {
		font-size: 0.775rem;
		font-weight: 600;
		color: #0369a1;
		background: #e0f2fe;
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
		flex-shrink: 0;
	}
	:global(.blog-title) {
		font-size: 0.925rem;
		font-weight: 600;
		color: #1e293b;
		flex: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	:global(.blog-arrow) {
		color: #64748b;
		flex-shrink: 0;
		font-size: 0.9rem;
	}

	.loading-text,
	.no-posts {
		color: #64748b;
		font-size: 0.875rem;
		text-align: center;
		padding: 1.5rem 0;
	}

	@media (max-width: 640px) {
		.hero {
			padding: 3.5rem 1rem 5rem;
		}
		.card {
			padding: 1.5rem 1rem;
		}
		:global(.blog-item) {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
		}
		:global(.blog-title) {
			white-space: normal;
		}
		:global(.blog-arrow) {
			display: none;
		}
	}
</style>
