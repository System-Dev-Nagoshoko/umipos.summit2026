---
import Layout from '../layouts/Layout.astro';
---

<Layout title="海のサインプロジェクト | 「見えない危険」から「伝わる安全」へ">
	<main>
		<section class="hero">
			<div class="container hero-inner">
				<div class="badge"><span class="badge-dot"></span>
					うみぽす甲子園2026 ファイナリスト</div>
				<div class="hero-text-wrap">
					<h1 class="hero-catch-title">
						<span class="line-from">「見えない危険」から</span>
						<span class="line-to">「<span class="highlight-aqua">伝わる安全</span>」へ</span>
					</h1><p class="hero-caption">
						看板だけに頼らず、持ち歩けるサインとサイトで沖縄の海を守る「海のサインプロジェクト」
					</p>
				</div>
				<!--ステータスバナー-->
				<div class="countdown-box is-production">
					<div class="countdown-header">
						<span class="countdown-label is-live">うみぽす甲子園2026 最終発表動画 公開中！</span>
						<span class="countdown-date-note">海に入る前から安全を届ける挑戦は、これからも続いていきます！</span>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container flex-container">
				<!--最終発表動画カード -->
				<div class="card featured-video-card">
					<div class="video-badge-row">
						<span class="video-tag">FINAL PRESENTATION</span>
						<span class="video-sub">うみぽす甲子園2026 最終発表動画</span></div>
					<h2>最終発表はこちら</h2>
					<p class="video-desc">私たちが取り組んでいる「見えない危険から伝わる安全へ」の活動と、海の安全を伝え続ける仕組みをまとめた最終発表です。ぜひご覧ください！</p>
					<div class="video-wrapper">
						<iframe src="https://www.youtube-nocookie.com/embed/E9Af2iGSPHk?rel=0" title="海のサインプロジェクト 最終発表" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe>
					</div>
					<div class="video-actions">
						<a href="https://www.youtube.com/watch?v=E9Af2iGSPHk" target="_blank" rel="noopener noreferrer" class="youtube-watch-btn">YouTubeで高評価・応援コメントする</a>
						<a href="https://www.youtube.com/channel/UCIgVHeQ7JWG11Ld9ztQjyDw" target="_blank" rel="noopener noreferrer" class="channel-sub-btn">プロジェクト公式YouTube</a>
						<a href="https://www.youtube.com/channel/UCNMQaHzpu6nnxoiiGwo_OrA" target="_blank" rel="noopener noreferrer" class="channel-sub-btn">大会公式チャンネル</a>
					</div>
				</div>

				<!-- プロジェクト概要カード-->
				<div class="card main-card">
					<div class="status-tag">PROJECT OVERVIEW</div>
					<h2>「海のサインプロジェクト」の挑戦</h2>
					<p class="desc">私たちは、沖縄の海での水難事故ゼロを目指して活動している高校生チームです。名護海上保安署・名護市消防本部・名護市観光課・沖縄県北部土木事務所の機関への取材や久米島分教室との交流を通じて見えた「文字ばかりの看板は読まれず、3〜4年で風景化してしまう」という課題に対し、<strong>海に入る前から安全を届け続ける新しい仕組み</strong>づくりを進めています。</p>

					<!--3つの柱-->
					<div class="presentation-steps">
						<div class="step-item">
							<span class="step-num">POINT 01｜調査と20種のピクトグラム</span>
							<h4>20種類のオリジナルピクトグラムを制作</h4>
							<p>泳ぎ・シュノーケリング事故者の27人中25人がライフジャケット未着用という現状や、ハブクラゲ等の危険生物被害を受け、仲間や他学年の生徒とも協力して直感的に伝わる20種類のピクトグラムを制作しました。</p>
						</div>
						<div class="step-item">
							<span class="step-num">POINT 02｜キーホルダー×多言語サイト</span>
							<h4>表はピクトグラム、裏はQRと緊急連絡先</h4>
							<p>レーザー加工機とUVプリンタで「持ち歩ける海の安全サイン（キーホルダー）」を制作。表面はピクトグラム、裏面はQRコードと「海のもしもは118 / 救急 119」、協力事業者名が入る仕様で、6言語対応の緊急SOS・ピクトグラム辞典や「How to SEA」動画へつながります。</p>
						</div>
						<div class="step-item">
							<span class="step-num">POINT 03｜これからの展開</span>
							<h4>ホテル・レンタカー事業者へ広げる挑戦</h4>
							<p>「海へ行く前に目にとまる場所で伝えることが大切」という取材での学びをもとに、今後はホテルのフロントやレンタカーのキーなど、海に入る前の手元に届ける提案を進めていきます。後輩へも引き継げる持続可能な活動を目指します！</p>
						</div>
					</div>

					<div class="message-box">
						<h3>私たちの想い</h3>
						<p>「せっかく沖縄に来たなら、安全に海を楽しもう！」<br/>メンバーそれぞれの得意分野（イラスト・動画編集・外部交渉・まとめ役等）を合わせ、海の事故ゼロを目指してこれからも活動を続けていきます！</p>
					</div>
				</div>

				<!-- 活動メディア（ライブRSS自動取得） -->
				<div class="card blog-card">
					<div class="blog-header"><div>
							<div class="archive-sub-tag">ACTIVITY LOG</div>
							<h2>最新の活動記録・メディア</h2></div>
						<div class="tab-controls" role="tablist">
							<button type="button" class="tab-btn active" data-source="blog">明日の地図</button>
							<button type="button" class="tab-btn" data-source="note">note</button>
							<button type="button" class="tab-btn" data-source="youtube">YouTube</button>
						</div>

						<a id="external-archive-link" href="https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/" target="_blank" rel="noopener noreferrer" class="all-posts-link">ブログ一覧を見る ↗</a>
					</div>
					<div id="blog-list-container" class="blog-list">
						<p class="loading-text">最新情報を読み込み中...</p>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	type FeedSource = { rssUrl: string; fallbackApiUrl?: string; filterKeywords: string[] };
	type MediaConfigItem = { feeds: FeedSource[]; archiveUrl: string; archiveLabel: string };
	type PostItem = { title: string; link: string; date: string; timestamp: number };
	const MEDIA_CONFIG: Record<'blog' | 'note' | 'youtube', MediaConfigItem> = {
		blog: {
			feeds: [{
				rssUrl: 'https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/feed/',
				fallbackApiUrl: '/api/rss',
				filterKeywords: []
			}],
			archiveUrl: 'https://umipos.com/koshien/repechage/author/%E6%B5%B7%E3%81%AE%E3%82%B5%E3%82%A4%E3%83%B3%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/',
			archiveLabel: 'ブログ一覧を見る'
		},
		note: {
			feeds: [{
				rssUrl: 'https://note.com/umi_sign_project/rss',
				fallbackApiUrl: '/api/rss-note',
				filterKeywords: []
			}],
			archiveUrl: 'https://note.com/umi_sign_project',
			archiveLabel: 'note一覧を見る'
		},
		youtube: {
			feeds: [
				{ rssUrl: 'https://www.youtube.com/feeds/videos.xml?channel_id=UCIgVHeQ7JWG11Ld9ztQjyDw', filterKeywords: [] },
				{
					rssUrl: 'https://www.youtube.com/feeds/videos.xml?channel_id=UCNMQaHzpu6nnxoiiGwo_OrA',
					fallbackApiUrl: '/api/rss-youtube',
					filterKeywords: ['海のサインプロジェクト', '海のサイン', '伝わる看板', 'How to SEA']
				}
			],
			archiveUrl: 'https://www.youtube.com/channel/UCIgVHeQ7JWG11Ld9ztQjyDw',
			archiveLabel: '公式YouTubeへ'
		}
	};
	type MediaType = keyof typeof MEDIA_CONFIG;
	const cache: Partial<Record<MediaType, PostItem[]>> = {};
	const escapeHtml = (str: string) => str.replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] || m));
	function formatDate(dateStr: string) {
		if (!dateStr) return { formatted: '', timestamp: 0 };
		const norm = dateStr.includes(' ') && !dateStr.includes('T') ? dateStr.replace(' ', 'T') + '+09:00' : dateStr;
		const d = new Date(norm);
		if (isNaN(d.getTime())) return { formatted: '', timestamp: 0 };
		return {
			formatted: `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`,
			timestamp: d.getTime()
		};
	}

	function parseXmlToPosts(xmlText: string, filterKeywords: string[]): PostItem[] {
		const doc = new DOMParser().parseFromString(xmlText, 'text/xml');
		if (doc.querySelector('parsererror')) return [];
		const entries = Array.from(doc.getElementsByTagName('entry'));
		const items = Array.from(doc.getElementsByTagName('item'));
		const isAtom = entries.length > 0;
		return (isAtom ? entries : items).map((item) => {
			const title = item.getElementsByTagName('title')[0]?.textContent?.trim() || '無題';
			let link = '#';
			if (isAtom) {
				const links = Array.from(item.getElementsByTagName('link'));
				link = (links.find((l) => l.getAttribute('rel') === 'alternate') || links[0])?.getAttribute('href') || '#';
			} else {
				link = item.getElementsByTagName('link')[0]?.textContent?.trim() || '#';
			}
			const pub = (isAtom ? item.getElementsByTagName('published')[0]?.textContent || item.getElementsByTagName('updated')[0]?.textContent : item.getElementsByTagName('pubDate')[0]?.textContent) || '';
			const { formatted, timestamp } = formatDate(pub);
			const desc = `${item.getElementsByTagName('description')[0]?.textContent || ''} ${item.getElementsByTagNameNS('*', 'description')[0]?.textContent || ''}`;
			return { title, link, date: formatted, timestamp, fullText: `${title} ${desc}` };
		})
		.filter((p) => filterKeywords.length === 0 || filterKeywords.some((kw) => p.fullText.includes(kw)))
		.map(({ title, link, date, timestamp }) => ({ title, link, date, timestamp }));
	}
	async function fetchSingleFeed(feed: FeedSource): Promise<PostItem[]> {
		const cb = Date.now();
		try {
			const res = await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feed.rssUrl)}&_=${cb}`);
			if (res.ok) {
				const data = await res.json();
				if (data.status === 'ok' && Array.isArray(data.items) && data.items.length > 0) {
					const list = data.items
						.filter((it: any) => feed.filterKeywords.length === 0 || feed.filterKeywords.some((kw) => `${it.title} ${it.description || ''}`.includes(kw)))
						.map((it: any) => ({ title: it.title || '無題', link: it.link || '#', date: formatDate(it.pubDate || '').formatted, timestamp: formatDate(it.pubDate || '').timestamp }));
					if (list.length > 0) return list;
				}
			}
		} catch (_) {}
		try {
			const res = await fetch(`https://api.allorigins.win/get?url=${encodeURIComponent(feed.rssUrl)}&_=${cb}`);
			if (res.ok) {
				const json = await res.json();
				if (json.contents) {
					const posts = parseXmlToPosts(json.contents, feed.filterKeywords);
					if (posts.length > 0) return posts;
				}
			}
		} catch (_) {}

		if (feed.fallbackApiUrl) {
			try {
				const res = await fetch(`${feed.fallbackApiUrl}?_=${cb}`);
				if (res.ok) {
					const posts = parseXmlToPosts(await res.text(), feed.filterKeywords);
					if (posts.length > 0) return posts;
				}
			} catch (_) {}
		}
		return [];
	}

	async function loadMedia(type: MediaType) {
		const container = document.getElementById('blog-list-container');
		const archiveLink = document.getElementById('external-archive-link') as HTMLAnchorElement | null;
		if (!container) return;

		const config = MEDIA_CONFIG[type];
		if (archiveLink) { archiveLink.href = config.archiveUrl; archiveLink.textContent = config.archiveLabel; }
		if (cache[type]) { renderPosts(cache[type]!, container); return; }

		container.innerHTML = '<p class="loading-text">最新情報を読み込み中...</p>';
		const merged = (await Promise.all(config.feeds.map(fetchSingleFeed))).flat();
		const uniqueMap = new Map<string, PostItem>();
		for (const item of merged) if (!uniqueMap.has(item.link)) uniqueMap.set(item.link, item);

		const topPosts = Array.from(uniqueMap.values()).sort((a, b) => b.timestamp - a.timestamp).slice(0, 4);
		if (topPosts.length > 0) {
			cache[type] = topPosts;
			renderPosts(topPosts, container);
		} else {
			container.innerHTML = '<p class="no-posts">最新の投稿は上の「一覧を見る」からご覧いただけます。</p>';
		}
	}

	function renderPosts(posts: PostItem[], container: HTMLElement) {
		container.innerHTML = posts.length === 0
			? '<p class="no-posts">該当する投稿はまだありません。</p>'
			: posts.map((p) => `<a href="${escapeHtml(p.link)}" target="_blank" rel="noopener noreferrer" class="blog-item"><div class="blog-date">${escapeHtml(p.date)}</div><div class="blog-title">${escapeHtml(p.title)}</div><div class="blog-arrow">↗</div></a>`).join('');
	}

	document.querySelectorAll('.tab-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const source = (btn as HTMLButtonElement).dataset.source as MediaType;
			if (!source) return;
			document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			loadMedia(source);
		});
	});
	loadMedia('blog');
</script>
<style>
	.hero { background: var(--ocean-gradient, radial-gradient(circle at 50% 25%, #0369a1 0%, #075985 55%, #082f49 100%)); color: #fff; padding: 3.5rem 1.25rem 5.5rem; text-align: center; position: relative; }
	.hero-inner { display: flex; flex-direction: column; align-items: center; max-width: 880px; margin: 0 auto; }
	.badge { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.14); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(125,211,252,0.45); padding: 0.45rem 1.25rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 800; color: #fff; letter-spacing: 0.04em; margin-bottom: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
	.badge-dot { width: 8px; height: 8px; background: #38bdf8; border-radius: 50%; box-shadow: 0 0 10px #38bdf8; }
	.hero-text-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
	.hero-catch-title { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; font-size: clamp(2.1rem,5.5vw,3.3rem); font-weight: 900; line-height: 1.35; margin: 0; letter-spacing: 0.02em; color: #fff; text-shadow: 0 2px 8px rgba(8,47,73,0.6); }
	.line-from { color: #f0f9ff; }
	.line-to { color: #fff; }
	.highlight-aqua { position: relative; display: inline-block; color: #fff; background: linear-gradient(transparent 62%, rgba(56,189,248,0.55) 62%, rgba(14,165,233,0.7) 100%); padding: 0 0.15em; border-radius: 2px; }
	.hero-caption { font-size: clamp(0.95rem,2.2vw,1.15rem); font-weight: 700; color: #e0f2fe; letter-spacing: 0.03em; margin-top: 0.25rem; text-shadow: 0 1px 4px rgba(8,47,73,0.5); }
	.countdown-box { margin-top: 1.85rem; background: rgba(8,47,73,0.65); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(125,211,252,0.55); border-radius: 18px; padding: 1rem 2rem; box-shadow: 0 10px 28px rgba(8,47,73,0.4); display: inline-flex; flex-direction: column; align-items: center; }
	.countdown-header { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; }
	.countdown-label.is-live { font-size: 1.05rem; font-weight: 800; color: #7dd3fc; letter-spacing: 0.04em; }
	.countdown-date-note { font-size: 0.85rem; font-weight: 700; color: #f0f9ff; letter-spacing: 0.04em; }
	.section { margin-top: -3.25rem; padding-bottom: 4.5rem; position: relative; z-index: 10; }
	.flex-container { display: flex; flex-direction: column; gap: 2.25rem; }
	.card { background: #fff; border-radius: 16px; padding: 2.5rem; box-shadow: 0 10px 25px -5px rgba(15,23,42,0.06); max-width: 1000px; margin: 0 auto; width: 100%; border: 1px solid var(--border, #e2e8f0); }
	.status-tag, .archive-sub-tag { display: inline-block; background: #f0f9ff; color: #0284c7; border: 1px solid #bae6fd; font-weight: 700; font-size: 0.72rem; padding: 0.25rem 0.7rem; border-radius: 9999px; margin-bottom: 0.65rem; letter-spacing: 0.04em; }
	.card h2 { font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; color: #0f172a; line-height: 1.4; border-bottom: 2px solid #e0f2fe; padding-bottom: 0.5rem; }
	.desc { color: #475569; line-height: 1.8; font-size: 1rem; margin-bottom: 1.75rem; }
	.desc strong { color: #0284c7; font-weight: 800; }
	.featured-video-card { background: linear-gradient(180deg, #f0f9ff 0%, #fff 35%); border: 2px solid #38bdf8; box-shadow: 0 18px 36px -8px rgba(2,132,199,0.18); }
	.video-badge-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.85rem; }
	.video-tag { display: inline-flex; align-items: center; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color: #fff; font-weight: 800; font-size: 0.78rem; letter-spacing: 0.05em; padding: 0.35rem 0.9rem; border-radius: 9999px; box-shadow: 0 3px 10px rgba(2,132,199,0.35); }
	.video-sub { font-size: 0.85rem; font-weight: 700; color: #0369a1; }
	.video-desc { color: #334155; font-size: 0.96rem; line-height: 1.7; margin-bottom: 1.35rem; }
	.video-wrapper { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #0f172a; box-shadow: 0 12px 28px -5px rgba(15,23,42,0.25); border: 1px solid #bae6fd; }
	.video-wrapper iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
	.video-actions { margin-top: 1.35rem; display: flex; justify-content: center; gap: 0.85rem; flex-wrap: wrap; }
	.youtube-watch-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; background: #dc2626; color: #fff; font-weight: 700; font-size: 0.9rem; padding: 0.72rem 1.55rem; border-radius: 9999px; text-decoration: none; box-shadow: 0 4px 12px rgba(220,38,38,0.25); transition: all 0.2s ease; }
	.youtube-watch-btn:hover { background: #b91c1c; transform: translateY(-2px); box-shadow: 0 6px 16px rgba(220,38,38,0.35); }
	.channel-sub-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; background: #f1f5f9; color: #0f172a; border: 1px solid #cbd5e1; font-weight: 700; font-size: 0.88rem; padding: 0.72rem 1.35rem; border-radius: 9999px; text-decoration: none; transition: all 0.2s ease; }
	.channel-sub-btn:hover { background: #e2e8f0; transform: translateY(-2px); }
	.presentation-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
	.step-item { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; display: flex; flex-direction: column; gap: 0.45rem; }
	.step-num { font-size: 0.75rem; font-weight: 800; color: #0284c7; letter-spacing: 0.03em; }
	.step-item h4 { font-size: 1rem; font-weight: 800; color: #0f172a; margin: 0; line-height: 1.4; }
	.step-item p { font-size: 0.88rem; color: #475569; line-height: 1.65; margin: 0; }
	.message-box { background: #f0f9ff; border-left: 4px solid #0284c7; padding: 1.25rem 1.5rem; border-radius: 8px; }
	.message-box h3 { font-size: 1.05rem; color: #0284c7; margin-bottom: 0.35rem; font-weight: 700; }
	.message-box p { color: #1e293b; line-height: 1.7; font-size: 0.95rem; margin: 0; }
	.blog-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.85rem; }
	.blog-header h2 { margin-bottom: 0; border-bottom: none; padding-bottom: 0; }
	.tab-controls { display: inline-flex; background: #f1f5f9; padding: 0.25rem; border-radius: 10px; border: 1px solid #e2e8f0; gap: 0.25rem; }
	.tab-btn { background: transparent; border: none; padding: 0.45rem 0.95rem; border-radius: 7px; font-size: 0.85rem; font-weight: 700; color: #64748b; cursor: pointer; transition: all 0.2s ease; }
