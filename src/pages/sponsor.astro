---
import Layout from '../layouts/Layout.astro';

const partners = [
  { 
    id: 'nsf',
    name: 'NSF PROJECTs', 
    role: '企画協賛', 
    logo: '/nsf.jpg', 
    url: 'https://nsf.stki.org/',
    description: '能登半島地震の復興支援を契機に発足した学生団体です。「能登の復興」と「中高生の防災意識向上」を目的に、全国の学生が連携しながら募金活動、防災サミットの開催、防災教育・政策提言などを幅広く行っています。'
  },
  { 
    id: 'trans',
    name: 'TRANs', 
    role: 'ドメイン提供', 
    logo: '/trans.png', 
    url: 'https://trans.stki.org/',
    description: '生徒会や学生団体のデジタル化・情報共有・システム統合に向け設立された機構です。当プロジェクトをはじめ、全国の学生主体プログラムへ共通ドメイン「stki.org」の基盤提供を行っています。'
  },
];

const coOrganizers: typeof partners = [];
const supporters: { name: string; category: string }[] = [];
---

<Layout title="連携・協力パートナー | 海のサインプロジェクト">
  <main class="page-wrapper">
    <section class="hero-section">
      <div class="hero-inner">
        <span class="sub-badge">PARTNERS & SUPPORTERS</span>
        <h1 class="page-title">連携・協力パートナー</h1>
        <p class="hero-desc">
          名護の海を「誰もが安心して楽しめる海」へ。<br />
          当プロジェクトは金銭的な協賛金を集めることは行わず、ドメインやWeb基盤の提供、資材・技術協力、周知活動などを通じて地域のパートナーの皆さまと共に進めています。
        </p>
      </div>
    </section>

    <div class="content-container">
      <section class="policy-card">
        <div class="info-icon">i</div>
        <div class="policy-text">
          <h2>支援・ご協力に関する方針</h2>
          <p>
            高校生主体の探究・地域貢献アクションとして運営しているため、<strong>個人・企業を問わず金銭的な協賛金・支援金の募集は一切行っておりません。</strong>
            看板の制作アドバイスや資材の提供、ドメイン・IT基盤の提供、ポスターの掲示場所のご提供、活動周知といった形でのサポートをお願いしております。
          </p>
        </div>
      </section>

      {coOrganizers.length > 0 && (
        <section class="card">
          <div class="card-header">
            <span class="section-label">CO-ORGANIZER</span>
            <h2>共催・連携団体</h2>
            <p class="section-sub">企画・運営を共に進めているパートナー団体です</p>
          </div>
          <div class="partner-grid">
            {coOrganizers.map((item) => (
              <button 
                type="button" 
                class="partner-item partner-trigger"
                data-name={item.name}
                data-role="共催"
                data-logo={item.logo}
                data-url={item.url}
                data-desc={item.description}
              >
                <img src={item.logo} alt={item.name} class="partner-logo" />
                <div class="partner-info">
                  <span class="tag-role">共催</span>
                  <h3 class="notranslate">{item.name}</h3>
                </div>
                <span class="more-hint">詳細を見る ➔</span>
              </button>
            ))}
          </div>
        </section>
      )}

      <section class="card">
        <div class="card-header">
          <span class="section-label">COOPERATION</span>
          <h2>協力パートナー</h2>
          <p class="section-sub">ロゴをタップすると詳細情報を確認できます</p>
        </div>
        <div class="partner-grid">
          {partners.map((partner) => (
            <button 
              type="button" 
              class="partner-item partner-trigger"
              data-name={partner.name}
              data-role={partner.role}
              data-logo={partner.logo}
              data-url={partner.url}
              data-desc={partner.description}
            >
              <img src={partner.logo} alt={partner.name} class="partner-logo" />
              <div class="partner-info">
                <h3 class="notranslate">{partner.name}</h3>
                <p class="role-text">{partner.role}</p>
              </div>
              <span class="more-hint">詳細を見る ➔</span>
            </button>
          ))}
        </div>
      </section>

      {supporters.length > 0 && (
        <section class="card">
          <div class="card-header">
            <span class="section-label">ENDORSEMENT</span>
            <h2>後援</h2>
            <p class="section-sub">本プロジェクトの趣旨にご賛同・後援いただいている機関・団体です</p>
          </div>
          <div class="supporter-grid">
            {supporters.map((item) => (
              <div class="supporter-item">
                <span class="supporter-name">{item.name}</span>
                <span class="supporter-cat">{item.category}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="cta-card">
        <h2>活動へのご協力・連携のご相談</h2>
        <p>
          「看板やポスターを店舗・施設に掲示してもいい」「海の安全に関する知識や専門的なアドバイスができる」「活動を取材したい」など、金銭以外の形での温かい連携やサポートを随時お待ちしております。
        </p>
        <div class="cta-buttons">
          <a href="https://forms.gle/YOUR_GOOGLE_FORM_URL" target="_blank" rel="noopener noreferrer" class="btn-primary">
            ご協力・連携のご連絡フォーム ➔
          </a>
          <a href="mailto:nyc.summit.umipos@outlook.jp" class="btn-secondary">
            メールでお問い合わせ
          </a>
        </div>
      </section>
    </div>

    <div id="partnerModal" class="modal-backdrop" aria-hidden="true">
      <div class="modal-card" role="dialog" aria-modal="true">
        <button type="button" id="modalClose" class="modal-close" aria-label="閉じる">✕</button>
        <div class="modal-header">
          <img id="modalLogo" src="" alt="" class="modal-logo" />
          <div>
            <span id="modalRole" class="modal-role-tag"></span>
            <h3 id="modalTitle" class="modal-title notranslate"></h3>
          </div>
        </div>
        <p id="modalDesc" class="modal-desc"></p>
        <div class="modal-actions">
          <a id="modalUrl" href="" target="_blank" rel="noopener noreferrer" class="modal-btn-primary">
            公式サイトを見る ↗
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const modal = document.getElementById('partnerModal');
  const modalClose = document.getElementById('modalClose');
  const modalLogo = document.getElementById('modalLogo') as HTMLImageElement;
  const modalTitle = document.getElementById('modalTitle');
  const modalRole = document.getElementById('modalRole');
  const modalDesc = document.getElementById('modalDesc');
  const modalUrl = document.getElementById('modalUrl') as HTMLAnchorElement;

  const triggers = document.querySelectorAll('.partner-trigger');

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.getAttribute('data-name') || '';
      const role = btn.getAttribute('data-role') || '';
      const logo = btn.getAttribute('data-logo') || '';
      const url = btn.getAttribute('data-url') || '';
      const desc = btn.getAttribute('data-desc') || '';

      if (modalLogo) {
        modalLogo.src = logo;
        modalLogo.alt = name;
      }
      if (modalTitle) modalTitle.textContent = name;
      if (modalRole) modalRole.textContent = role;
      if (modalDesc) modalDesc.textContent = desc;
      if (modalUrl) modalUrl.href = url;

      if (modal) {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
      }
    });
  });

  function closeModal() {
    if (modal) {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    }
  }

  if (modalClose) modalClose.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
      closeModal();
    }
  });
</script>

<style>
  .page-wrapper {
    background-color: var(--bg, #f8fafc);
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  .hero-section {
    background: var(--ocean-gradient, radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%));
    color: #ffffff;
    padding: 3.5rem 1.25rem 4.5rem;
    text-align: center;
  }
  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .sub-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.25rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .page-title {
    font-size: 2.1rem;
    font-weight: 800;
    margin-bottom: 0.85rem;
    line-height: 1.3;
    text-shadow: 0 2px 8px rgba(8, 47, 73, 0.5);
  }
  .hero-desc {
    color: #e0f2fe;
    font-size: 0.95rem;
    line-height: 1.7;
    font-weight: 500;
  }

  .content-container {
    max-width: 900px;
    margin: -3rem auto 0;
    padding: 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    z-index: 10;
  }

  .policy-card {
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .info-icon {
    width: 36px;
    height: 36px;
    background: #0284c7;
    color: white;
    font-weight: 800;
    font-size: 1.2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .policy-text h2 {
    font-size: 1rem;
    font-weight: 700;
    color: #0284c7;
    margin-bottom: 0.35rem;
  }
  .policy-text p {
    font-size: 0.85rem;
    color: #334155;
    line-height: 1.65;
  }

  .card {
    background: #ffffff;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04);
  }
  .card-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }
  .section-label {
    color: #0284c7;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.25rem;
  }
  .card-header h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.35rem;
  }
  .section-sub {
    font-size: 0.8rem;
    color: #64748b;
  }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .partner-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    color: inherit;
    transition: all 0.2s ease;
    cursor: pointer;
    text-align: left;
    width: 100%;
    font-family: inherit;
  }
  .partner-item:hover {
    background: white;
    border-color: #38bdf8;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
  }
  .partner-logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 6px;
    flex-shrink: 0;
  }
  .partner-info {
    flex: 1;
  }
  .tag-role {
    font-size: 0.7rem;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.25rem;
  }
  .partner-info h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1e293b;
  }
  .role-text {
    font-size: 0.75rem;
    color: #0284c7;
    font-weight: 600;
    margin-top: 0.15rem;
  }
  .more-hint {
    font-size: 0.75rem;
    color: #0284c7;
    font-weight: 700;
    flex-shrink: 0;
  }

  .supporter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .supporter-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
  }
  .supporter-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
  }
  .supporter-cat {
    font-size: 0.7rem;
    color: #64748b;
    background: white;
    border: 1px solid #e2e8f0;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .cta-card {
    background: linear-gradient(135deg, #0369a1 0%, #082f49 100%);
    color: white;
    border-radius: 16px;
    padding: 2.5rem 1.75rem;
    text-align: center;
  }
  .cta-card h2 {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }
  .cta-card p {
    font-size: 0.85rem;
    color: #e0f2fe;
    line-height: 1.7;
    max-width: 650px;
    margin: 0 auto 1.5rem;
  }
  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: #0284c7;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
  }
  .btn-primary:hover {
    background: #0369a1;
    transform: translateY(-1px);
  }
  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .modal-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 2rem;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    position: relative;
    transform: translateY(12px);
    transition: transform 0.25s ease;
  }
  .modal-backdrop.is-open .modal-card {
    transform: translateY(0);
  }
  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #f1f5f9;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 1rem;
    cursor: pointer;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .modal-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
  .modal-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-right: 2rem;
  }
  .modal-logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 6px;
    flex-shrink: 0;
  }
  .modal-role-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.25rem;
  }
  .modal-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }
  .modal-desc {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
  }
  .modal-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #0284c7;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .modal-btn-primary:hover {
    background: #0369a1;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 2.75rem 1rem 4.4rem;
    }
    .page-title {
      font-size: 1.65rem;
    }
    .card {
      padding: 1.25rem;
    }
    .cta-buttons {
      flex-direction: column;
    }
    .modal-card {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
