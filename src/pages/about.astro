---
import Layout from '../../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="ABOUT | Sea Sign Project">
	<main>
		<!-- Page Header: Ocean Gradient Consistent Across All Pages -->
		<section class="page-header">
			<div class="container">
				<h1>ABOUT</h1>
				<p>About the Sea Sign Project</p>
			</div>
		</section>

		<section class="section">
			<div class="container flex-container">
				
				<!-- Brand Card -->
				<div class="card main-card">
					
					<!-- Logo & Team Feature Area -->
					<div class="brand-banner">
						<div class="brand-logo-container">
							<img 
								src={`${baseUrl}logo.png`} 
								alt="Sea Sign Project Logo" 
								class="brand-logo-img" 
							/>
						</div>
						<div class="brand-text">
							<span class="brand-sub">A High School Student Initiative for Coastal Safety Awareness</span>
							<h2 class="brand-title">Sea Sign Project</h2>
						</div>
					</div>

					<div class="card-content">
						<div class="block">
							<h3>🔴 The Challenge of Coastal Warning Signs</h3>
							<p>Coastal warning signs often go unnoticed. Existing signs frequently suffer from small typography and unclear visuals, making it difficult for beachgoers to recognize immediate dangers such as rip currents or dangerous marine life at a glance.</p>
						</div>

						<div class="block">
							<h3>🔴 From "Signs to Look At" to "Signs that Truly Communicate"</h3>
							<p>To prevent accidents before they happen, we need signage that intuitively communicates risks in seconds to everyone—children, the elderly, and international travelers alike—transcending age and language barriers.</p>
						</div>

						<div class="block highlight-block">
							<h3>🚀 Mission of the Project</h3>
							<p>We conduct on-site field surveys across the coastline of Nago City, Okinawa, analyzing hazard spots and researching sign designs.</p>
							<p>Our goal is to make Nago's pristine ocean a place where both local residents and tourists can enjoy with safety, confidence, and smiles through accessible, highly visible sign designs.</p>
						</div>
					</div>
				</div>

				<!-- Card 2: Organization & Key Activities -->
				<div class="card">
					<h2>Organization & Key Activities</h2>
					<p class="card-intro">
						As finalists in "Umipos Koshien 2026," we are actively working on coastal safety and community awareness initiatives in Nago City.
					</p>

					<div class="block">
						<h3>🎯 Core Objectives</h3>
						<ul class="styled-list">
							<li>Field surveys of Nago's coastline to identify safety risks and evaluate existing warning signs.</li>
							<li>Designing and producing universal coastal safety signs that anyone—including children and international visitors—can understand instantly.</li>
							<li>Promoting ocean safety awareness (rules and marine manners) alongside the natural beauty of Nago.</li>
							<li>Collaborating with local communities and organizations to create a sustainable, safe coastal environment.</li>
						</ul>
					</div>

					<div class="block">
						<h3>📌 Key Initiatives</h3>
						<div class="grid-list">
							<div class="grid-item">
								<strong>1. Coastal Fieldwork Research</strong>
								<p>Surveying coastlines in Nago City to document hazardous areas and assess the visibility of existing signs.</p>
							</div>
							<div class="grid-item">
								<strong>2. Signboard Design & Development</strong>
								<p>Creating intuitive designs utilizing pictograms, optimal typography, and high-contrast color schemes.</p>
							</div>
							<div class="grid-item">
								<strong>3. Safety & Ocean Outreach</strong>
								<p>Sharing the beauty of Nago's waters and essential marine safety tips via blogs and official social channels.</p>
							</div>
							<div class="grid-item">
								<strong>4. Community Events & Exhibitions</strong>
								<p>Organizing exhibitions and interactive events to engage the community in coastal safety.</p>
							</div>
						</div>
					</div>

					<div class="profile-box">
						<dl class="profile-dl">
							<div>
								<dt>Organizer</dt>
								<dd class="dd-with-logo">
									<span>Sea Sign Project</span>
									<img src={`${baseUrl}logo.png`} alt="Logo" class="profile-logo" />
								</dd>
							</div>
							<div>
								<dt>Partner</dt>
								<dd>Nago city Youth Creative PROJECTs</dd>
							</div>
							<div>
								<dt>Competition</dt>
								<dd>Umipos Koshien 2026 (Finalist)</dd>
							</div>
						</dl>
					</div>
				</div>

			</div>
		</section>
	</main>
</Layout>

<style>
	/* Page Header */
	.page-header {
		background: var(--ocean-gradient, radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%));
		color: #ffffff;
		padding: 4.5rem 1.25rem 5.5rem;
		text-align: center;
	}
	.page-header h1 {
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-shadow: 0 2px 8px rgba(8, 47, 73, 0.5);
	}
	.page-header p {
		color: #e0f2fe;
		font-size: 1rem;
		margin-top: 0.5rem;
		font-weight: 500;
	}

	/* Main Layout */
	.section {
		padding: 3rem 0;
	}
	.flex-container {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	/* Card Base */
	.card {
		background: #ffffff;
		border-radius: 16px;
		padding: 2.5rem;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
		max-width: 1000px;
		margin: 0 auto;
		width: 100%;
		border: 1px solid var(--border, #e2e8f0);
		overflow: hidden;
	}

	/* Brand Banner */
	.brand-banner {
		display: flex;
		align-items: center;
		gap: 2rem;
		background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
		border: 1px solid #bae6fd;
		padding: 1.75rem 2rem;
		border-radius: 12px;
		margin-bottom: 2rem;
	}
	.brand-logo-container {
		width: 110px;
		height: 110px;
		background: #ffffff;
		border-radius: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 12px;
		box-shadow: 0 4px 15px rgba(2, 132, 199, 0.12);
		flex-shrink: 0;
		border: 1px solid #e2e8f0;
	}
	.brand-logo-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.brand-text {
		flex: 1;
	}
	.brand-sub {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 700;
		color: #0284c7;
		margin-bottom: 0.25rem;
		letter-spacing: 0.03em;
	}
	.brand-title {
		font-size: 1.85rem;
		font-weight: 900;
		color: #0f172a;
		line-height: 1.25;
		margin: 0;
		border: none !important;
		padding: 0 !important;
	}

	.card h2 {
		font-size: 1.45rem;
		color: #0f172a;
		border-bottom: 2px solid #e0f2fe;
		padding-bottom: 0.5rem;
		margin-bottom: 1.5rem;
		font-weight: 700;
	}
	.card-intro {
		color: #334155;
		line-height: 1.8;
		margin-bottom: 1.5rem;
		font-size: 0.975rem;
	}
	.block {
		margin-bottom: 1.5rem;
	}
	.block h3 {
		font-size: 1.1rem;
		color: #0284c7;
		margin-bottom: 0.5rem;
		font-weight: 700;
	}
	.block p {
		color: #475569;
		line-height: 1.8;
		font-size: 0.975rem;
	}

	/* Highlight Box */
	.highlight-block {
		background: #f0f9ff;
		border: 1px solid #bae6fd;
		padding: 1.5rem;
		border-radius: 12px;
	}
	.highlight-block p + p {
		margin-top: 0.75rem;
	}

	/* Styled List */
	.styled-list {
		list-style: none;
		padding-left: 0;
	}
	.styled-list li {
		position: relative;
		padding-left: 1.25rem;
		color: #475569;
		line-height: 1.7;
		margin-bottom: 0.4rem;
		font-size: 0.95rem;
	}
	.styled-list li::before {
		content: "•";
		color: #0284c7;
		font-weight: bold;
		position: absolute;
		left: 0.25rem;
	}

	/* Grid Activity List */
	.grid-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1rem;
		margin-top: 0.75rem;
	}
	.grid-item {
		background: #f8fafc;
		padding: 1.25rem;
		border-radius: 12px;
		border: 1px solid #e2e8f0;
	}
	.grid-item strong {
		display: block;
		color: #0284c7;
		font-size: 0.95rem;
		margin-bottom: 0.35rem;
	}
	.grid-item p {
		font-size: 0.875rem;
		line-height: 1.6;
		color: #475569;
	}

	/* Profile Box */
	.profile-box {
		margin-top: 2rem;
	}
	.profile-dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
		background: #f8fafc;
		padding: 1.25rem 1.5rem;
		border-radius: 12px;
		border: 1px solid #e2e8f0;
	}
	.profile-dl dt {
		font-size: 0.85rem;
		color: #0284c7;
		font-weight: 700;
		margin-bottom: 0.25rem;
	}
	.profile-dl dd {
		font-size: 0.95rem;
		color: #1e293b;
		font-weight: 500;
	}

	/* Profile Logo */
	.dd-with-logo {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.profile-logo {
		height: 28px;
		width: auto;
		object-fit: contain;
	}

	/* Mobile Responsive */
	@media (max-width: 640px) {
		.card {
			padding: 1.5rem 1.25rem;
		}
		.brand-banner {
			flex-direction: column;
			text-align: center;
			gap: 1rem;
			padding: 1.5rem 1rem;
		}
		.brand-logo-container {
			width: 90px;
			height: 90px;
			padding: 10px;
		}
		.brand-title {
			font-size: 1.45rem;
		}
		.profile-dl {
			grid-template-columns: 1fr;
			padding: 1rem;
		}
	}
</style>
