---
import Layout from '../layouts/Layout.astro';
---

<Layout title="現在制作中 | 海のサインプロジェクト">
  <main class="coming-wrapper">
    <div class="glow-bg"></div>

    <div class="coming-card">
      <div class="status-pill">COMING SOON</div>

      <h1 class="main-title">
        <span class="gradient-text">現在制作中</span>
      </h1>

      <p class="description">
        公開までもうしばらくお待ちください。
      </p>

      <div class="action-box">
        <a href="/" class="btn-top">トップページへ戻る</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .coming-wrapper {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem 5rem;
    position: relative;
    overflow: hidden;
    background-color: #fafafa;
  }

  /* 背景の柔らかな光 */
  .glow-bg {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, rgba(2, 132, 199, 0.04) 50%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
  }

  .coming-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.05);
    padding: 4rem 2.5rem;
    max-width: 520px;
    width: 100%;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .status-pill {
    display: inline-block;
    letter-spacing: 0.25em;
    font-size: 0.8rem;
    font-weight: 900;
    color: #0284c7;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    padding: 0.4rem 1.25rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .main-title {
    font-size: 2.5rem;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .gradient-text {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .description {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .action-box {
    border-top: 1px solid #f1f5f9;
    padding-top: 2rem;
  }

  .btn-top {
    display: inline-block;
    background: #0284c7;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.85rem 2rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25);
  }

  .btn-top:hover {
    background: #0369a1;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.35);
  }

  @media (max-width: 640px) {
    .coming-card {
      padding: 3rem 1.5rem;
    }
    .main-title {
      font-size: 2rem;
    }
  }
</style>
