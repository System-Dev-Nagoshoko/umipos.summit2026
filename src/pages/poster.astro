/* ==========================================================================
   モーダル (スマホ画面でも上下がはみ出さず中央に配置)
   ========================================================================== */
.ss-panel {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 1000;
  padding: clamp(0.75rem, 3vw, 1.5rem);
  align-items: center;     /* 上下中央に配置 */
  justify-content: center; /* 左右中央に配置 */
}

.ss-panel.is-open {
  display: flex !important;
}

.ss-panel__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.65);
}

.ss-panel__box {
  position: relative;
  width: min(540px, 100%);
  /* 画面全体の高さ（dvh）に合わせてモーダル上限を設定 */
  max-height: min(85dvh, 600px); 
  overflow-y: auto; /* 中身が長い場合はモーダル内だけスクロール */
  background: #ffffff !important;
  border-radius: var(--radius-lg);
  padding: clamp(1.25rem, 4vw, 1.75rem);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
  z-index: 10;
  margin: auto; /* スマホで確実に中央配置 */
}

.ss-panel__close {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  font-size: 1.8rem;
  line-height: 1;
  background: none;
  border: none;
  color: #64748b;
  cursor: pointer;
  padding: 0.25rem 0.5rem;
  border-radius: 6px;
}

.ss-panel__close:hover {
  background: #f1f5f9;
  color: #0f172a;
}

.ss-panel__head {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
  padding-right: 1.5rem;
}

.ss-panel__head img {
  width: clamp(70px, 18vw, 110px);
  height: clamp(70px, 18vw, 110px);
  object-fit: contain;
  border: 1px solid #e2e8f0;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: #fff;
}

.ss-panel__head h2 {
  font-size: clamp(1.1rem, 3vw, 1.35rem);
  border: none;
  padding: 0;
  margin: 0;
  color: #0f172a;
  font-weight: 800;
}

.ss-panel__body dt {
  font-size: 0.875rem;
  color: #475569;
  font-weight: 800;
  margin-top: 0.75rem;
}

.ss-panel__body dd {
  color: #0f172a;
  font-size: 0.95rem;
  line-height: 1.6;
  border-bottom: 1px solid #e2e8f0;
  padding-bottom: 0.75rem;
  margin: 0.25rem 0 0;
}

.ss-note {
  font-size: 0.85rem;
  color: #dc2626;
  margin-top: 0.75rem;
  font-weight: 700;
}

.ss-panel__back {
  display: block;
  width: 100%;
  margin-top: 1.25rem;
  padding: 0.75rem;
  border-radius: var(--radius-sm);
  border: none;
  text-align: center;
  background: #f1f5f9;
  color: #0f172a;
  font-weight: 800;
  cursor: pointer;
  font-size: 0.95rem;
}

.ss-panel__back:hover {
  background: #e2e8f0;
}

/* スマホ表示時の余白調整 */
@media (max-width: 480px) {
  .ss-panel {
    padding: 0.75rem;
  }
  .ss-panel__box {
    max-height: 82dvh; /* 画面下部のナビバー等の干渉を避ける */
    padding: 1.25rem 1rem;
  }
}
