---
/**
 * POSTER ページ：海のピクトグラム辞典（HOW TO SEA）
 * 本文コンポーネントを統合した単一ページファイル
 * 看板のQRコードの行き先：/poster/#〇〇（〇〇は how-to-sea.ts の id）
 */
import Layout from '../layouts/Layout.astro';
import { genres, reportItems, IMAGE_BASE } from '../data/how-to-sea';

const callLabel = { "119": "119", "118": "118", lifeguard: "監視員" } as const;
---

<Layout title="海のピクトグラム辞典 | 海のサインプロジェクト">
  <section class="page-header">
    <h1>PICTOGRAM GUIDE</h1>
    <p>看板の絵の意味と、緊急時の応急手当・通報ガイド</p>
  </section>

  <section class="section">
    <div class="container">
      <div class="flex-container">

        <!-- 緊急時SOSカード（最上部に配置してアクセス時間を短縮） -->
        <div class="card emergency-top-card" id="emergency">
          <div class="emergency-alert-head">
            <span class="alert-badge">SOS</span>
            <h2>もしもの時・緊急通報ガイド</h2>
          </div>
          <p class="ss-lead">当てはまる状況にチェックすると連絡先が表示されます。今すぐ電話する場合は上のボタン、または以下の赤・青の番号から直接お電話ください。</p>

          <form class="ss-report" id="report" aria-describedby="report-msg">
            <fieldset>
              <legend class="ss-subhead">いま、どんな状況ですか（いくつでも）</legend>
              <ul class="ss-report__list">
                {reportItems.map((r) => (
                  <li>
                    <label>
                      <input type="checkbox" data-call={r.call.join(" ")} />
                      <span>{r.text}</span>
                      <span class="ss-report__tags">
                        {r.call.map((c) => <b class={`is-${c}`}>{callLabel[c]}</b>)}
                      </span>
                    </label>
                  </li>
                ))}
              </ul>
            </fieldset>

            <div class="ss-report__result">
              <div class="ss-report__msg" id="report-msg" aria-live="polite">
                <p data-msg="none">当てはまるものにチェックすると通報先が表示されます。</p>
                <p data-msg="both" hidden>119 と 118 の両方に電話してください。</p>
                <p data-msg="119" hidden>119（救急・消防）に電話してください。</p>
                <p data-msg="118" hidden>118（海の事件・事故）に電話してください。</p>
                <p data-msg="lifeguard" hidden>近くのビーチ監視員に知らせてください。具合が悪くなったらすぐ119へ。</p>
                <p data-msg="also-lifeguard" hidden>ビーチ監視員にも知らせてください。</p>
              </div>
              <ul class="ss-tel">
                <li><a class="ss-tel__btn" id="call-119" href="tel:119"><strong>119</strong>救急・消防</a></li>
                <li><a class="ss-tel__btn" id="call-118" href="tel:118"><strong>118</strong><span>海の事件・事故<span class="ss-tel__sub">（海上保安庁）</span></span></a></li>
                <li class="ss-tel__wide"><span class="ss-tel__btn ss-tel__btn--lifeguard" id="call-lifeguard"><strong>監視所</strong>ビーチ監視員</span></li>
              </ul>
              <button type="reset" class="ss-report__reset">選択をリセット</button>
            </div>
          </form>

          <div class="ss-two">
            <section aria-labelledby="tell-title">
              <h3 class="ss-subhead" id="tell-title">電話で伝えること</h3>
              <ul class="ss-plainlist">
                <li>場所（海岸の名前や近くの目印）</li>
                <li>状況（おぼれた・刺された・ケガ等）</li>
                <li>人数と傷病者の様子（意識の有無）</li>
              </ul>
            </section>

            <section aria-labelledby="case-title">
              <h3 class="ss-subhead" id="case-title">その場の応急対応</h3>
              <dl class="ss-case">
                <div><dt><a href="#rip-current">沖に流された</a></dt><dd>あわてず岸と平行に泳ぐ。手を振って助けを呼ぶ。</dd></div>
                <div><dt><a href="#jellyfish">クラゲに刺された</a></dt><dd>こすらず酢をかけて触手を取り、冷やす。</dd></div>
                <div><dt><a href="#stonefish">オコゼを踏んだ</a></dt><dd>動かさず40〜45℃のお湯につけて病院へ。</dd></div>
                <div><dt><a href="#alone">おぼれている人を見た</a></dt><dd>飛び込まず浮くものを投げ、118・119へ通報。</dd></div>
              </dl>
            </section>
          </div>
        </div>

        <!-- ピクトグラム一覧 -->
        <div class="card">
          <h2>ピクトグラム一覧（看板の絵の意味）</h2>
          <p class="ss-lead">看板の絵をタップすると、意味と対処法が表示されます。</p>
          <nav class="ss-toc" aria-label="もくじ">
            {genres.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
          </nav>

          {genres.map((g) => (
            <section class="ss-group" id={g.id} aria-labelledby={`${g.id}-title`}>
              <h3 id={`${g.id}-title`}>{g.title}</h3>
              <p class="ss-group__desc">{g.desc}</p>
              <div class="ss-grid">
                {g.items.filter((item) => !item.hidden).map((item) => (
                  <a class="ss-tile" id={`t-${item.id}`} href={`#${item.id}`}>
                    {item.image
                      ? <img src={`${IMAGE_BASE}${item.image}`} alt="" loading="lazy" decoding="async" />
                      : <span class="ss-tile__noimg">準備中</span>}
                    <span>{item.name}</span>
                  </a>
                ))}
              </div>

              {g.id === "cat-rules" && (
                <Fragment>
                  <h4 class="ss-subhead">このビーチで禁止されていること</h4>
                  <ul class="ss-plainlist ss-plainlist--cols">
                    <li>シュノーケルの使用</li>
                    <li>防護ネットに触れる</li>
                    <li>火気（タバコ・BBQ）</li>
                    <li>遊泳区域でのペットの散歩</li>
                    <li>監視台に登る</li>
                    <li>小学生・中学生だけで泳ぐ</li>
                  </ul>
                </Fragment>
              )}
            </section>
          ))}
        </div>

      </div>
    </div>
  </section>

  <div class="ss-panels">
    {genres.flatMap((g) => g.items).filter((item) => !item.hidden).map((item) => (
      <section class="ss-panel" id={item.id} aria-labelledby={`${item.id}-title`}>
        <a class="ss-panel__backdrop" href={`#t-${item.id}`} aria-label="とじる"></a>
        <div class="ss-panel__box">
          <a class="ss-panel__close" href={`#t-${item.id}`} aria-label="とじる">×</a>
          <div class="ss-panel__head">
            {item.image
              ? <img src={`${IMAGE_BASE}${item.image}`} alt={item.alt} loading="lazy" decoding="async" />
              : <span class="ss-panel__noimg">準備中</span>}
            <div class="ss-panel__title"><h2 id={`${item.id}-title`}>{item.name}</h2></div>
          </div>
          <dl class="ss-panel__body">
            {item.rows.map(([label, text]) => (
              <Fragment><dt>{label}</dt><dd>{text}</dd></Fragment>
            ))}
          </dl>
          {item.note && <p class="ss-note">{item.note}</p>}
          <a class="ss-panel__back" href={`#t-${item.id}`}>一覧にもどる</a>
        </div>
      </section>
    ))}
  </div>
</Layout>

<script>
  function initReport() {
    const form = document.getElementById("report");
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "1";
    const msg = document.getElementById("report-msg");
    const btns: Record<string, HTMLElement | null> = {
      "119": document.getElementById("call-119"),
      "118": document.getElementById("call-118"),
      lifeguard: document.getElementById("call-lifeguard"),
    };

    Object.values(btns).forEach((btn) => {
      if (btn?.hasAttribute("href")) btn.dataset.href = btn.getAttribute("href") ?? "";
    });

    const setEnabled = (btn: HTMLElement | null, on: boolean) => {
      if (!btn) return;
      btn.classList.toggle("is-needed", on);
      btn.classList.toggle("is-disabled", !on);
      btn.setAttribute("aria-disabled", on ? "false" : "true");
      const href = btn.dataset.href;
      if (!href) return;
      if (on) btn.setAttribute("href", href);
      else btn.removeAttribute("href");
    };

    const update = () => {
      const need: Record<string, boolean> = {};
      form.querySelectorAll<HTMLInputElement>("input[data-call]:checked").forEach((box) => {
        (box.dataset.call ?? "").split(" ").forEach((key) => (need[key] = true));
      });
      const any = Object.keys(need).length > 0;
      Object.entries(btns).forEach(([key, btn]) => setEnabled(btn, !!need[key]));
      form.classList.toggle("is-active", any);

      let main = "none";
      if (need["119"] && need["118"]) main = "both";
      else if (need["119"]) main = "119";
      else if (need["118"]) main = "118";
      else if (need.lifeguard) main = "lifeguard";
      const alsoLifeguard = (need["119"] || need["118"]) && need.lifeguard;
      msg?.querySelectorAll<HTMLElement>("[data-msg]").forEach((el) => {
        const key = el.dataset.msg;
        el.hidden = !(key === main || (key === "also-lifeguard" && alsoLifeguard));
      });
    };

    form.addEventListener("change", update);
    form.addEventListener("reset", () => setTimeout(update, 0));
    form.addEventListener("submit", (e) => e.preventDefault());
    update();
  }

  initReport();
  document.addEventListener("astro:page-load", initReport);
</script>

<style>
  .page-header { background: var(--ocean-gradient, radial-gradient(circle at 50% 30%, #0369a1 0%, #075985 55%, #082f49 100%)); color: #fff; padding: 3.5rem 1.25rem 4.5rem; text-align: center; }
  .page-header h1 { font-size: 2.2rem; font-weight: 800; letter-spacing: .05em; text-shadow: 0 2px 8px rgba(8, 47, 73, .5); }
  .page-header p { color: #e0f2fe; font-size: 0.95rem; margin-top: .35rem; font-weight: 500; text-wrap: balance; }
  
  .section { padding-bottom: 4rem; position: relative; z-index: 10; }
  .flex-container { display: flex; flex-direction: column; gap: 2.25rem; margin-top: -3rem; }
  .card { background: #fff; border-radius: 16px; padding: 2.5rem; box-shadow: 0 10px 25px -5px #0f172a0d; max-width: 1000px; margin: 0 auto; width: 100%; border: 1px solid var(--border, #e2e8f0); overflow: hidden; }
  .card h2 { font-size: 1.45rem; font-weight: 700; margin-bottom: 1.25rem; color: #0f172a; border-bottom: 2px solid #e0f2fe; padding-bottom: .5rem; }
  .card::before { display: none; }

  .emergency-top-card {
    border: 2px solid #fecdd3 !important;
    background: #ffffff !important;
  }

  .emergency-alert-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .alert-badge {
    background: #dc2626;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.8rem;
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }

  .emergency-alert-head h2 {
    margin-bottom: 0;
    border-bottom: none;
    padding-bottom: 0;
    color: #991b1b;
  }

  .ss-call-119 { --ss-call-119: #dc2626; }
  .ss-call-118 { --ss-call-118: #1d4ed8; }
  .ss-call-guard { --ss-call-guard: #047857; }

  .ss-lead { color: #334155; font-size: 0.95rem; line-height: 1.75; }
  .ss-subhead { font-size: 1rem; font-weight: 700; color: #0f172a; margin: 1.5rem 0 0.5rem; }
  .ss-note { font-size: .8rem; color: #b91c1c; margin-top: .75rem; }
  .ss-plainlist { padding-left: 1.2em; color: #475569; font-size: .9rem; line-height: 1.7; }
  .ss-plainlist--cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; }

  .ss-toc { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid #e2e8f0; }
  .ss-toc a { color: var(--primary); font-weight: 700; font-size: .9rem; text-decoration: none; }
  .ss-toc a:hover { text-decoration: underline; }

  .ss-group { margin-top: 2.5rem; scroll-margin-top: 100px; }
  .ss-group h3 { font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 0.35rem; }
  .ss-group__desc { color: #475569; font-size: .9rem; line-height: 1.6; margin-bottom: 1.25rem; }

  .ss-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 1.25rem; }
  .ss-tile { display: flex; flex-direction: column; gap: .5rem; text-decoration: none; color: #0f172a; font-weight: 700; font-size: .9rem; line-height: 1.4; scroll-margin-top: 150px; }
  .ss-tile img, .ss-tile__noimg { width: 100%; aspect-ratio: 1; object-fit: contain; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: .75rem; transition: border-color .15s ease; }
  .ss-tile:hover img, .ss-tile:hover .ss-tile__noimg { border-color: var(--primary); }
  .ss-tile__noimg, .ss-panel__noimg { display: grid; place-items: center; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; color: #94a3b8; font-size: .8rem; font-weight: 700; }

  :global(.main-content:has(.ss-panels)) { animation-name: ssPageFade; }
  @keyframes ssPageFade { from { opacity: 0; } to { opacity: 1; } }
  .ss-panel { display: none; }
  .ss-panel:target { display: flex; align-items: center; justify-content: center; position: fixed; inset: 0; z-index: 100; padding: 88px 1rem 1rem; }
  .ss-panel__backdrop { position: absolute; inset: 0; background: rgba(15, 23, 42, .55); }
  .ss-panel__box { position: relative; width: min(560px, 100%); max-height: 100%; overflow-y: auto; background: #fff; border-radius: 14px; padding: 2rem; box-shadow: 0 24px 48px -16px rgba(15, 23, 42, .35); }
  .ss-panel__close { position: absolute; top: .9rem; right: .9rem; width: 2.25rem; height: 2.25rem; border-radius: 8px; display: grid; place-items: center; color: #64748b; font-size: 1.4rem; line-height: 1; text-decoration: none; }
  .ss-panel__close:hover { background: #f1f5f9; color: #0f172a; }
  .ss-panel__head { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; padding-right: 2rem; }
  .ss-panel__head img { width: 140px; height: 140px; flex-shrink: 0; object-fit: contain; border: 1px solid #e2e8f0; border-radius: 10px; padding: .6rem; }
  .ss-panel__head h2 { font-size: 1.5rem; font-weight: 900; color: #0f172a; line-height: 1.35; }
  .ss-panel__body { display: grid; grid-template-columns: 6.5em 1fr; border-top: 1px solid #e2e8f0; }
  .ss-panel__body dt, .ss-panel__body dd { padding: .75rem 0; border-bottom: 1px solid #e2e8f0; }
  .ss-panel__body dt { font-size: .85rem; color: #475569; font-weight: 700; padding-top: .9rem; }
  .ss-panel__body dd { color: #0f172a; font-size: .95rem; line-height: 1.75; }
  .ss-panel__back { display: block; margin-top: 1.5rem; padding: .7rem; border-radius: 10px; text-align: center; border: 1px solid #cbd5e1; color: #0f172a; font-weight: 700; text-decoration: none; }
  .ss-panel__back:hover { background: #f8fafc; }

  .ss-report { margin-top: 1.25rem; }
  .ss-report fieldset { border: 0; }
  .ss-report__list { list-style: none; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
  .ss-report__list li + li { border-top: 1px solid #e2e8f0; }
  .ss-report__list label { display: flex; align-items: center; gap: .85rem; padding: .85rem 1.1rem; cursor: pointer; font-size: .95rem; line-height: 1.5; color: #0f172a; }
  .ss-report__list label:hover { background: #f8fafc; }
  .ss-report__list label:has(input:checked) { background: #fef2f2; font-weight: 700; }
  .ss-report__list input { width: 1.2rem; height: 1.2rem; flex-shrink: 0; accent-color: #dc2626; }
  .ss-report__list label > span:first-of-type { flex: 1; }
  .ss-report__tags { display: flex; gap: .3rem; flex-shrink: 0; }
  .ss-report__tags b { font-size: .75rem; font-weight: 700; padding: .1rem .45rem; border-radius: 4px; color: #fff; line-height: 1.5; }
  .ss-report__tags .is-119 { background: #dc2626; }
  .ss-report__tags .is-118 { background: #1d4ed8; }
  .ss-report__tags .is-lifeguard { background: #047857; }
  .ss-report__result { margin-top: 1.25rem; padding: 1.5rem; border-radius: 12px; background: #f8fafc; }
  .ss-report.is-active .ss-report__result { background: #fff7f7; }
  .ss-report__msg { font-weight: 700; font-size: 1.05rem; color: #0f172a; text-align: center; margin-bottom: 1rem; }
  .ss-report__msg [data-msg="also-lifeguard"] { margin-top: .25rem; }
  .ss-report__reset { display: block; margin: 1rem auto 0; background: none; border: none; cursor: pointer; font: inherit; font-size: .85rem; color: #64748b; text-decoration: underline; text-underline-offset: 3px; }

  .ss-tel { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .ss-tel__wide { grid-column: 1 / -1; }
  .ss-tel__btn { display: flex; align-items: baseline; justify-content: center; gap: .6rem; height: 100%; padding: 1rem; border-radius: 12px; color: #fff; font-weight: 700; text-decoration: none; text-align: center; }
  .ss-tel__btn strong { font-size: 1.8rem; line-height: 1; letter-spacing: .02em; }
  #call-119 { background: #dc2626; }
  #call-118 { background: #1d4ed8; }
  .ss-tel__btn--lifeguard { background: #047857; padding: .75rem 1rem; font-size: .9rem; align-items: center; }
  .ss-tel__btn--lifeguard strong { font-size: 1.1rem; }
  .ss-tel__btn.is-disabled { background: #e2e8f0 !important; color: #94a3b8; cursor: not-allowed; pointer-events: none; }

  .ss-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 3rem; margin-top: 1rem; }
  .ss-case div { padding: .75rem 0; border-bottom: 1px solid #e2e8f0; }
  .ss-case div:first-child { border-top: 1px solid #e2e8f0; }
  .ss-case dt a { color: var(--primary); font-weight: 700; text-decoration: none; }
  .ss-case dt a:hover { text-decoration: underline; }
  .ss-case dd { color: #475569; font-size: .9rem; line-height: 1.7; margin-top: .15rem; }

  @media (max-width: 640px) {
    .container { padding: 0 1rem; }
    .card { padding: 1.5rem .85rem; }
    .page-header { padding: 2.75rem 1rem 4.5rem; }
    .page-header h1 { font-size: 1.85rem; }
    .page-header p { font-size: .9rem; }
    .ss-lead, .ss-group__desc { font-size: .9rem; }
    .ss-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem .75rem; }
    .ss-tile { font-size: .85rem; }
    .ss-plainlist--cols { grid-template-columns: 1fr; }
    .ss-panel:target { align-items: flex-end; padding: 72px 0 0; }
    .ss-panel__box { width: 100%; border-radius: 14px 14px 0 0; padding: 1.25rem 1rem 1.4rem; }
    .ss-panel__head img, .ss-panel__noimg { width: 88px; height: 88px; }
    .ss-panel__head h2 { font-size: 1.2rem; }
    .ss-panel__body { grid-template-columns: 1fr; }
    .ss-panel__body dt { border-bottom: none; padding: .7rem 0 0; }
    .ss-panel__body dd { padding: .15rem 0 .7rem; }
    .ss-report__list label { padding: .65rem .7rem; font-size: .875rem; gap: .55rem; }
    .ss-tel { gap: .5rem; }
    .ss-tel__btn { flex-direction: column; align-items: center; gap: .25rem; padding: .7rem .4rem; font-size: .8rem; line-height: 1.4; }
    .ss-tel__btn--lifeguard { flex-direction: row; gap: .5rem; }
    .ss-two { grid-template-columns: 1fr; }
  }
</style>
