  <script>
    // 通報ガイド：チェックした状況に必要な番号のボタンだけを押せるようにする
    function initReportGuide() {
      const form = document.getElementById('report') as HTMLFormElement | null;
      if (!form) return;
      const msg = document.getElementById('report-msg');
      const btns: Record<string, HTMLElement | null> = {
        '119': document.getElementById('call-119'),
        '118': document.getElementById('call-118'),
        lifeguard: document.getElementById('call-lifeguard')
      };

      Object.keys(btns).forEach((key) => {
        const btn = btns[key];
        if (btn && btn.hasAttribute('href')) {
          btn.setAttribute('data-href', btn.getAttribute('href') || '');
        }
      });

      function setEnabled(btn: HTMLElement | null, on: boolean) {
        if (!btn) return;
        btn.classList.toggle('is-needed', on);
        btn.classList.toggle('is-disabled', !on);
        btn.setAttribute('aria-disabled', on ? 'false' : 'true');
        const href = btn.getAttribute('data-href');
        if (!href) return;
        if (on) btn.setAttribute('href', href);
        else btn.removeAttribute('href');
      }

      function update() {
        const need: Record<string, boolean> = {};
        form?.querySelectorAll<HTMLInputElement>('input[data-call]:checked').forEach((box) => {
          const calls = box.getAttribute('data-call');
          if (calls) {
            calls.split(' ').forEach((key) => { need[key] = true; });
          }
        });
        const any = Object.keys(need).length > 0;

        Object.keys(btns).forEach((key) => { setEnabled(btns[key], !!need[key]); });
        form?.classList.toggle('is-active', any);

        let text = '';
        if (need['119'] && need['118']) text = '119 と 118 の両方に電話してください。';
        else if (need['119']) text = '119（救急・消防）に電話してください。';
        else if (need['118']) text = '118（海の事件・事故）に電話してください。';
        else if (need.lifeguard) text = '近くのビーチ監視員に知らせてください。具合が悪くなったら、すぐに119へ。';
        else text = '当てはまるものにチェックすると、電話ボタンが押せるようになります。今すぐ電話する時は、ページ上の119・118ボタンから。';
        
        if ((need['119'] || need['118']) && need.lifeguard) text += '監視員にも知らせてください。';
        if (msg) msg.textContent = text;
      }

      form.addEventListener('change', update);
      form.addEventListener('reset', () => { setTimeout(update, 0); });
      form.addEventListener('submit', (e) => { e.preventDefault(); });
      update();
    }

    document.addEventListener('astro:page-load', initReportGuide);
    if (document.readyState !== 'loading') {
      initReportGuide();
    } else {
      document.addEventListener('DOMContentLoaded', initReportGuide);
    }
  </script>
</Layout>

