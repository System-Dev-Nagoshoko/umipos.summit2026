---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="現在制作中 | 海のサインプロジェクト">
  <main class="coming-wrapper">
    <!-- ゆらめく背景グロー -->
    <div class="glow-bg"></div>

    <!-- メインカード（フェードイン・フロートアニメーション） -->
    <div class="coming-card">
      <div class="status-pill-wrap">
        <div class="status-pill">COMING SOON</div>
        <div class="ping-circle"></div>
      </div>

      <h1 class="main-title">
        <span class="shimmer-text">現在制作中</span>
      </h1>

      <p class="description">
        新しい安全看板の特設ページを鋭意制作中です。<br />
        公開までもうしばらくお待ちください。
      </p>

      <div class="action-box">
        <a href={baseUrl} class="btn-top">トップページへ戻る</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .coming-wrapper {
    min-height: calc(100vh - 180px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem 5rem;
    position: relative;
    overflow: hidden;
    background-color: var(--bg, #f8fafc);
  }

  /* 1. 背景の呼吸アニメーション */
  .glow-bg {
    position: absolute;
    width: 550px;
    height: 550px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.22) 0%, rgba(2, 132, 199, 0.05) 55%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
    animation: breathGlow 8s ease-in-out infinite alternate;
  }

  @keyframes breathGlow {
    0% {
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0.7;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.15);
      opacity: 1;
    }
  }

  /* 2. カードのふわっと出現＋微細なフロート */
  .coming-card {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 28px;
    box-shadow: 0 25px 50px -12px rgba(2, 132, 199, 0.08), 0 4px 12px rgba(0, 0, 0, 0.03);
    padding: 4.5rem 3rem;
    max-width: 540px;
    width: 100%;
    text-align: center;
    position: relative;
    z-index: 2;
    animation: fadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* 3. COMING SOON バッジと波紋 */
  .status-pill-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: 1.75rem;
  }

  .status-pill {
    position: relative;
    display: inline-block;
    letter-spacing: 0.25em;
    font-size: 0.78rem;
    font-weight: 900;
    color: #0284c7;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    padding: 0.45rem 1.35rem;
    border-radius: 9999px;
    z-index: 2;
  }

  .ping-circle {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-color: rgba(56, 189, 248, 0.4);
    z-index: 1;
    animation: ripple 2.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ripple {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.35, 1.7);
      opacity: 0;
    }
  }

  /* 4. タイトルの光沢シマーアニメーション */
  .main-title {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.25;
    margin-bottom: 1.25rem;
    letter-spacing: 0.04em;
  }

  .shimmer-text {
    background: linear-gradient(
      90deg,
      #0284c7 0%,
      #0284c7 25%,
      #38bdf8 50%,
      #0284c7 75%,
      #0284c7 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerWave 4s linear infinite;
  }

  @keyframes shimmerWave {
    to {
      background-position: 200% center;
    }
  }

  .description {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.8;
    margin-bottom: 2.75rem;
  }

  /* ボタン */
  .action-box {
    border-top: 1px solid var(--border, #e2e8f0);
    padding-top: 2rem;
  }

  .btn-top {
    display: inline-block;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.85rem 2.25rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 15px rgba(2, 132, 199, 0.25);
  }

  .btn-top:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(2, 132, 199, 0.35);
    background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
  }

  @media (max-width: 640px) {
    .coming-card {
      padding: 3.5rem 1.75rem;
      border-radius: 20px;
    }
    .main-title {
      font-size: 2.1rem;
    }
    .btn-top {
      width: 100%;
    }
  }
</style>
